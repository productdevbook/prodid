{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "prodid-edge",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-19",
	// `nodejs_compat` because postgres.js reaches for Node built-ins; it is the driver Hyperdrive
	// documents for PostgreSQL.
	//
	// `global_fetch_strictly_public` is about routing, not addresses: it makes a fetch of our own
	// zone go to the front door and be treated as a request from the Internet instead of being
	// routed to the origin behind it, bypassing Cloudflare's security settings. It is not an
	// address filter and does not keep the crawler out of private networks; `net/guard.ts` says
	// what does and what does not.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// One queue message reads at most one 256 MiB feed. Review measured 119 ms of CPU per MiB, so
	// the worst message is ~30 s of CPU — over the 30 s default and far inside this.
	"limits": {
		"cpu_ms": 120000,
	},
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	// edge answers prodid.org/id/*, /01/*, /source/*, /ping and /schemas/*, plus media.prodid.org.
	// Routes are attached at deploy time; this file declares none.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "f7711bc2567f42b2921653856d688c93",
			"localConnectionString": "postgres://prodid:prodid@127.0.0.1:54329/prodid",
		},
	],
	"durable_objects": {
		"bindings": [{ "name": "LIMITS", "class_name": "RateLimiter" }],
	},
	// Declarative form; `exports` and `migrations` cannot both be present.
	"exports": {
		"RateLimiter": { "type": "durable-object", "storage": "sqlite" },
	},
	"r2_buckets": [
		// Stored media, served immutably from media.prodid.org under sha256/{hex}. The bucket has
		// no public domain of its own: a blocked hash has to answer 410, which only a Worker can do.
		{ "binding": "MEDIA", "bucket_name": "prodid-media" },
	],
	// The lapse notice. Email Service sends from this address only.
	"send_email": [{ "name": "MAIL", "allowed_sender_addresses": ["notify@prodid.org"] }],
	"queues": {
		"producers": [
			{ "binding": "CRAWL", "queue": "prodid-crawl" },
			// Written to directly: a crawl held back by our own limits past the cap is not a failed
			// message, so it never reaches the consumer's dead letter queue on its own.
			{ "binding": "CRAWL_DLQ", "queue": "prodid-crawl-dlq" },
			{ "binding": "MEDIA_INGEST", "queue": "prodid-media-ingest" },
			// Written to directly for the same reason as `CRAWL_DLQ`.
			{ "binding": "MEDIA_DLQ", "queue": "prodid-media-dlq" },
			{ "binding": "NOTIFY", "queue": "prodid-notify" },
		],
		"consumers": [
			{
				"queue": "prodid-crawl",
				// One unit of work per message — discovery, one feed, or the finalize — so the
				// longest invocation is one feed's 10-minute deadline inside the 15-minute wall
				// clock a Queue consumer gets.
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 3,
				"dead_letter_queue": "prodid-crawl-dlq",
			},
			{
				// One file per message, capped well under the wall clock and the isolate.
				"queue": "prodid-media-ingest",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 3,
				"dead_letter_queue": "prodid-media-dlq",
			},
			{
				// An operator reads this one; nothing re-drives it automatically.
				"queue": "prodid-crawl-dlq",
				"max_batch_size": 10,
				"max_batch_timeout": 30,
				"max_retries": 1,
			},
			{
				"queue": "prodid-media-dlq",
				"max_batch_size": 10,
				"max_batch_timeout": 30,
				"max_retries": 1,
			},
			{
				"queue": "prodid-notify",
				"max_batch_size": 10,
				"max_batch_timeout": 30,
				"max_retries": 3,
				"dead_letter_queue": "prodid-notify-dlq",
			},
			{
				"queue": "prodid-notify-dlq",
				"max_batch_size": 10,
				"max_batch_timeout": 30,
				"max_retries": 1,
			},
		],
	},
	"triggers": {
		// Every ten minutes: enqueue the sources that are due, then run the lapse sweep.
		"crons": ["*/10 * * * *"],
	},
	"vars": {
		// How long a source waits between scheduled crawls. A ping only makes the next one sooner.
		"CRAWL_INTERVAL_MINUTES": "360",
		"DOH_ENDPOINT": "https://cloudflare-dns.com/dns-query",
		// Names under this zone are hosted slugs, whatever they serve: a document there proves
		// control of a slug, not of a domain. The index only classifies them; `apps/hosted` serves
		// them, and the crawler reaches it over DNS and HTTPS like any other host.
		"HOSTING_ZONE": "prodid.org",
		// The only host that serves `/sha256/*`, and the only thing it serves.
		"MEDIA_HOST": "media.prodid.org",
	},
}
