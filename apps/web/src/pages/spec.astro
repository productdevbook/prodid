---
import { Disclosure } from '@/components/disclosure'
import SpecToc from '@/components/spec-toc.astro'
import Layout from '@/layouts/base.astro'
import { getEntry, render } from 'astro:content'

const entry = await getEntry('spec', 'readme')
if (!entry) {
	throw new Error('spec/README.md could not be loaded; /spec renders it at build time and must not be built without it.')
}

const { Content, headings } = await render(entry)

const files = Object.keys(
	import.meta.glob('../../../../spec/{schemas/v1,fixtures/v1/examples}/*', { query: '?raw', import: 'default', eager: true }),
)
	.map((path) => path.replace('../../../../spec/', ''))
	.sort()
---

<Layout
	title="Specification — prodid"
	description="The prodid specification, v1: identifiers, entity kinds, publishing and discovery, claims, resolving and media."
	active="spec"
>
	<div class="shell">
		<div class="py-12 lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-14 lg:py-16">
			<article class="prose max-w-[68ch] min-w-0">
				<p class="not-prose mb-6 font-mono text-xs tracking-[0.18em] text-soft uppercase">Specification</p>
				<Content />
			</article>

			<aside class="mt-14 lg:order-last lg:mt-0">
				<Disclosure client:visible className="lg:hidden">
					<Fragment slot="title">On this page</Fragment>
					<SpecToc headings={headings} />
				</Disclosure>

				<nav
					data-spec-toc
					aria-label="On this page"
					class="sticky top-20 hidden max-h-[calc(100svh-6rem)] overflow-y-auto overscroll-contain border-s ps-5 lg:block"
				>
					<h2 class="text-xs font-semibold tracking-wider text-soft uppercase">On this page</h2>
					<div class="mt-3">
						<SpecToc headings={headings} />
					</div>

					<h2 class="mt-9 text-xs font-semibold tracking-wider text-soft uppercase">Files</h2>
					<p class="mt-3 text-sm leading-relaxed text-soft">
						Conformance vectors live in{' '}
						<a href="/spec/fixtures/v1" class="rounded-sm font-mono text-[0.8125rem] underline underline-offset-4 hover:text-brand">
							/spec/fixtures/v1</a
						>.
					</p>
					<ul class="mt-3 grid gap-2 font-mono text-[0.78rem]">
						{
							files.map((file) => (
								<li>
									<a href={`/spec/${file}`} class="rounded-sm break-all text-soft underline-offset-4 hover:text-brand hover:underline">
										{file}
									</a>
								</li>
							))
						}
					</ul>

					<h2 class="mt-9 text-xs font-semibold tracking-wider text-soft uppercase">Source</h2>
					<p class="mt-3 text-sm leading-relaxed text-soft">
						This page is rendered from{' '}
						<a href="/spec/README.md" class="rounded-sm font-mono text-[0.8125rem] underline underline-offset-4 hover:text-brand">
							spec/README.md
						</a>{' '}
						at build time. What changed from v0 is in{' '}
						<a href="/spec/v1-from-v0.md" class="rounded-sm font-mono text-[0.8125rem] underline underline-offset-4 hover:text-brand">
							spec/v1-from-v0.md</a
						>.
					</p>
				</nav>
			</aside>
		</div>
	</div>
</Layout>

<script>
	const toc = document.querySelector<HTMLElement>('[data-spec-toc]')
	const links = new Map<string, HTMLAnchorElement>()
	for (const link of toc?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]') ?? []) links.set(decodeURIComponent(link.hash.slice(1)), link)
	const headings = [...document.querySelectorAll<HTMLElement>('article h2[id], article h3[id]')].filter((heading) => links.has(heading.id))

	let current: HTMLAnchorElement | undefined
	let queued = false

	// The section being read is the last heading that has scrolled past the sticky header.
	function update(): void {
		queued = false
		if (toc === null || toc.offsetParent === null) return
		let active = headings[0]
		const atEnd = innerHeight + scrollY >= document.documentElement.scrollHeight - 2
		if (atEnd) active = headings.at(-1)
		else for (const heading of headings) {
			if (heading.getBoundingClientRect().top > 120) break
			active = heading
		}
		const link = active === undefined ? undefined : links.get(active.id)
		if (link === current) return
		current?.removeAttribute('aria-current')
		current = link
		if (link === undefined) return
		link.setAttribute('aria-current', 'location')
		const top = link.getBoundingClientRect().top - toc.getBoundingClientRect().top + toc.scrollTop
		if (top < toc.scrollTop + 40 || top > toc.scrollTop + toc.clientHeight - 80) {
			toc.scrollTo({ top: Math.max(0, top - toc.clientHeight / 3), behavior: 'auto' })
		}
	}

	function schedule(): void {
		if (queued) return
		queued = true
		requestAnimationFrame(update)
	}

	addEventListener('scroll', schedule, { passive: true })
	addEventListener('resize', schedule)
	update()
</script>
