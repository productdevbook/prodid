---
import Publish from '@/components/pages/publish.astro'
import { TRANSLATED } from '@/i18n/locales'

export function getStaticPaths() {
	return TRANSLATED.map((locale) => ({ params: { lang: locale.code }, props: { code: locale.code } }))
}

const { code } = Astro.props
---

<Publish code={code} />
