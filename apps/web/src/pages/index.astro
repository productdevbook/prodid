---
import CodeSample from '@/components/code-sample.astro'
import Layout from '@/layouts/base.astro'

const DESCRIPTION =
	'prodid gives every physical product a permanent open identifier. GTIN, MPN and every other code resolve to it, and every fact is a claim attributed to its source.'

const model = [
	{
		kind: 'family',
		title: 'Acme Trail Jacket',
		opid: '5c8nt0we1qv7hj2b',
		note: 'the product as people talk about it',
	},
	{
		kind: 'variant',
		title: 'navy · size M',
		opid: '9htb4e0qmr75w2xk',
		note: 'one combination of variant axes',
	},
	{
		kind: 'item',
		title: 'retail unit for DE and TR',
		opid: '7qk2m9x4rb3fhd80',
		note: 'the thing that carries a barcode',
	},
]

const indents = ['pl-0', 'pl-5 sm:pl-10', 'pl-10 sm:pl-20']

const identifiers = [
	{ scheme: 'gtin', value: '09506000134352', note: 'printed on the box, in the barcode and the QR code' },
	{ scheme: 'mpn', value: 'TJ-2041-NVY-M', note: 'the manufacturer part number, scoped to the brand' },
	{ scheme: 'sku', value: 'ACM-TJ-NVY-M', note: 'a retailer stock code, scoped to that retailer' },
]

const steps = [
	{
		verb: 'Publish',
		body: 'A manufacturer serves one file on its own domain, listing feeds of the products it makes. No account, no API key, no contract. A software vendor that hosts thousands of merchants serves the same file on each merchant domain. A manufacturer that cannot serve files at all delegates the hosting with one DNS TXT record — checked before anything served on the domain, because only the domain owner can set it.',
		link: { href: '/publish', label: 'How to publish' },
	},
	{
		verb: 'Index',
		body: 'prodid fetches the file and the feeds, validates every line against the published schemas, assigns or matches an opid, and records each field as a claim attributed to that domain. Retailers, registries and open datasets are sources in exactly the same way: their claims sit beside the manufacturer, never on top of it.',
		link: { href: '/spec#claims', label: 'How claims work' },
	},
	{
		verb: 'Resolve',
		body: 'The code on the box becomes an address. prodid.org/01/{gtin} is GS1 Digital Link syntax, which means it can be the QR code printed on the product itself. Ask for HTML and you get a page a shopper can read; ask for JSON and you get the record, every claim carrying its source.',
		link: { href: '/spec#resolving', label: 'How resolving works' },
	},
]

const audiences = [
	{
		title: 'Manufacturers and exporters',
		body: 'State your product data once, on your own domain, in a form every buyer, marketplace and customs desk can read. Publishing it yourself means no buyer has to take a reseller listing as the truth about what you make, and no marketplace owns the canonical description of your own product.',
	},
	{
		title: 'E-commerce, ERP and PIM vendors',
		body: 'You already hold this data for your customers. Publishing it is one discovery document per merchant domain and one feed, generated from what you have. Your customers get a public, attributed, machine-readable record without a new integration for every buyer who asks.',
	},
	{
		title: 'Developers and data consumers',
		body: 'Resolve any barcode to a stable identifier that survives repackaging and market changes. Every fact carries the source that made it, when it was seen and under what licence, so you decide what to trust rather than inheriting somebody else’s merge. Identifiers and full dumps are open.',
	},
]

const response = `{
  "opid": "7qk2m9x4rb3fhd80",
  "kind": "item",
  "parent": "9htb4e0qmr75w2xk",
  "identifiers": [
    { "scheme": "gtin", "value": "09506000134352" },
    { "scheme": "mpn", "value": "TJ-2041-NVY-M", "scope": "acme" }
  ],
  "claims": [
    {
      "property": "brand",
      "value": "Acme",
      "source": "acme.example",
      "trust": "verified",
      "seen_at": "2026-09-12T08:31:44Z"
    },
    {
      "property": "name",
      "value": "Trail Jacket",
      "lang": "en",
      "source": "acme.example",
      "trust": "verified",
      "seen_at": "2026-09-12T08:31:44Z"
    },
    {
      "property": "properties.material",
      "value": "100% recycled polyester",
      "source": "acme.example",
      "trust": "verified",
      "seen_at": "2026-09-12T08:31:44Z"
    },
    {
      "property": "properties.material",
      "value": "polyester",
      "source": "example-open-db.org",
      "trust": "unverified",
      "seen_at": "2026-08-30T19:02:10Z"
    }
  ]
}`

const request = `GET /01/09506000134352 HTTP/1.1
Host: prodid.org
Accept: application/json`
---

<Layout title="prodid — open identity for every physical product" description={DESCRIPTION}>
	<section class="shell">
		<div class="max-w-3xl pt-16 pb-14 sm:pt-24 sm:pb-20">
			<p class="font-mono text-xs tracking-[0.18em] text-soft uppercase">Open product identity</p>
			<h1 class="mt-5 text-[2rem] leading-[1.12] font-semibold tracking-tight sm:text-[3.1rem]">
				An open identity and data layer for every physical product.
			</h1>
			<p class="mt-6 max-w-2xl text-lg leading-relaxed text-soft sm:text-xl">
				prodid gives every product a permanent open identifier. Barcodes, part numbers and catalogue codes resolve to it.
				Every fact about the product is a claim, and every claim carries the source that made it.
			</p>
			<div class="mt-9 flex flex-wrap items-center gap-3">
				<a
					href="/publish"
					class="rounded-md bg-ink px-5 py-2.5 text-sm font-medium text-bg transition-opacity hover:opacity-85"
				>
					Publish your products
				</a>
				<a
					href="/spec"
					class="rounded-md border border-rule px-5 py-2.5 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
				>
					Read the specification
				</a>
			</div>
			<p class="mt-8 text-sm text-soft">
				Specification <strong class="font-medium text-ink">v0 draft</strong>. Reference implementation in progress — the
				resolver is not live yet.
			</p>
		</div>
	</section>

	<section aria-labelledby="problem" class="border-t border-line">
		<div class="shell py-16 sm:py-20">
			<div class="max-w-3xl">
				<p class="font-mono text-xs tracking-[0.18em] text-soft uppercase">The problem</p>
				<h2 id="problem" class="mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">A barcode is not a product.</h2>
				<div class="mt-6 grid gap-5 text-base leading-relaxed sm:text-lg [&>*]:min-w-0">
					<p>
						The same jacket carries one barcode in Germany and another in Türkiye. A third when it ships in a two-pack.
						A fourth when the packaging changes next year. None of those numbers means <em>this product</em>; each one
						means <em>this trade item, in this packaging, for this market, this year</em>.
					</p>
					<p>
						Meanwhile what anyone actually wants to know — the material, the weight, the energy label, the manual, the
						recall notice — sits somewhere else for every one of those codes: in the manufacturer’s PIM, in a
						retailer’s catalogue, in a national registry, in an open database somebody scraped. Nothing joins them, and
						nothing records who said what.
					</p>
					<p>
						prodid does two things about that. It gives the product itself an identifier that does not change when the
						barcode does. And it keeps every fact as a claim, attributed to the source that made it, so disagreement is
						visible instead of silently overwritten.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section aria-labelledby="model" class="border-t border-line">
		<div class="shell py-16 sm:py-20">
			<div class="max-w-3xl">
				<p class="font-mono text-xs tracking-[0.18em] text-soft uppercase">The model</p>
				<h2 id="model" class="mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">
					Family, variant, item — then the codes.
				</h2>
				<p class="mt-6 text-base leading-relaxed text-soft sm:text-lg">
					Three kinds of entity, each with its own <code class="chip">opid</code>: 16 opaque characters that encode
					nothing, are never reused and never deleted. Identifiers are not entities. They point at one.
				</p>
			</div>

			<div class="mt-10 overflow-hidden rounded-xl border border-line bg-surface">
				<ol class="divide-y divide-line">
					{
						model.map((level, i) => (
							<li class:list={['px-5 py-4 sm:px-6', indents[i]]}>
								<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
									<span class="w-16 shrink-0 font-mono text-[0.7rem] tracking-wider text-soft uppercase">{level.kind}</span>
									<span class="font-medium">{level.title}</span>
									<span class="font-mono text-[0.8125rem] text-soft">{level.opid}</span>
								</div>
								<p class="mt-1 pl-0 text-sm text-soft sm:pl-19">{level.note}</p>
							</li>
						))
					}
				</ol>
				<div class="border-t border-line bg-sunken px-5 py-4 sm:px-6">
					<p class="text-xs font-semibold tracking-wider text-soft uppercase">Identifiers that resolve to that item</p>
					<ul class="mt-3 grid gap-2.5 [&>*]:min-w-0">
						{
							identifiers.map((id) => (
								<li class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
									<span class="w-16 shrink-0 font-mono text-[0.7rem] tracking-wider text-soft uppercase">{id.scheme}</span>
									<span class="font-mono text-[0.875rem]">{id.value}</span>
									<span class="text-sm text-soft">{id.note}</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
			<p class="mt-4 max-w-3xl text-sm leading-relaxed text-soft">
				Change the packaging and a new item appears with a new barcode, under the same variant and the same family. The
				old <code class="chip">opid</code> keeps resolving. Nothing that ever pointed at it breaks.
			</p>
		</div>
	</section>

	<section aria-labelledby="how" class="border-t border-line">
		<div class="shell py-16 sm:py-20">
			<div class="max-w-3xl">
				<p class="font-mono text-xs tracking-[0.18em] text-soft uppercase">How it works</p>
				<h2 id="how" class="mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">Publish, index, resolve.</h2>
			</div>
			<ol class="mt-10 grid gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-3 [&>*]:min-w-0">
				{
					steps.map((step, i) => (
						<li class="flex flex-col bg-surface p-6">
							<p class="font-mono text-xs text-soft">{String(i + 1).padStart(2, '0')}</p>
							<h3 class="mt-3 text-lg font-semibold tracking-tight">{step.verb}</h3>
							<p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-soft">{step.body}</p>
							<a href={step.link.href} class="mt-5 rounded-sm text-sm font-medium text-accent underline-offset-4 hover:underline">
								{step.link.label} →
							</a>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section aria-labelledby="example" class="border-t border-line">
		<div class="shell py-16 sm:py-20">
			<div class="max-w-3xl">
				<p class="font-mono text-xs tracking-[0.18em] text-soft uppercase">An example</p>
				<h2 id="example" class="mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">
					One URL, printed on the product.
				</h2>
				<p class="mt-6 text-base leading-relaxed text-soft sm:text-lg">
					<code class="chip">https://prodid.org/01/09506000134352</code> is a GS1 Digital Link, so it can be the QR code on
					the label itself. A shopper scanning it gets a page. A system asking for JSON gets the record — the same
					mechanism the EU Digital Product Passport is built on.
				</p>
			</div>
			<div class="mt-10 grid max-w-3xl gap-5 [&>*]:min-w-0">
				<CodeSample code={request} lang="http" label="Request" />
				<CodeSample
					code={response}
					lang="json"
					label="Response"
					badge="application/json"
					caption="Two sources disagree about the material. Both claims are kept, both attributed, neither silently wins. The response shape is part of the v0 draft and will change before v1."
				/>
			</div>
		</div>
	</section>

	<section aria-labelledby="who" class="border-t border-line">
		<div class="shell py-16 sm:py-20">
			<div class="max-w-3xl">
				<p class="font-mono text-xs tracking-[0.18em] text-soft uppercase">Who it is for</p>
				<h2 id="who" class="mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">
					The people who make the data, and the people who need it.
				</h2>
			</div>
			<div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 [&>*]:min-w-0">
				{
					audiences.map((audience) => (
						<div class="border-t border-rule pt-5">
							<h3 class="text-base font-semibold tracking-tight">{audience.title}</h3>
							<p class="mt-3 text-[0.9375rem] leading-relaxed text-soft">{audience.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section aria-labelledby="status" class="border-t border-line">
		<div class="shell py-16 sm:py-20">
			<div class="max-w-3xl">
				<p class="font-mono text-xs tracking-[0.18em] text-soft uppercase">Status</p>
				<h2 id="status" class="mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">Where this actually stands.</h2>
				<ul class="mt-8 grid gap-5 [&>*]:min-w-0">
					<li class="border-l-2 border-rule pl-5">
						<p class="font-medium">The specification is a v0 draft.</p>
						<p class="mt-1 text-[0.9375rem] leading-relaxed text-soft">
							Anything in it may change until v1, including the record schemas and the shape of a resolver response.{' '}
							<a href="/spec" class="rounded-sm text-accent underline-offset-4 hover:underline">Read it</a> and say where it
							is wrong.
						</p>
					</li>
					<li class="border-l-2 border-rule pl-5">
						<p class="font-medium">The reference implementation is in progress.</p>
						<p class="mt-1 text-[0.9375rem] leading-relaxed text-soft">
							The resolver, the index and the crawler are being built. <code class="chip">prodid.org/01/…</code> does not
							resolve yet, and no feed has been crawled. Every URL shown on this site is the specified shape, not a live
							endpoint.
						</p>
					</li>
					<li class="border-l-2 border-rule pl-5">
						<p class="font-medium">The index is meant to be replaceable.</p>
						<p class="mt-1 text-[0.9375rem] leading-relaxed text-soft">
							The specification, the schemas, the identifiers and the full data dumps are CC0. If this index is run badly,
							somebody else can run it from the same data. That is the point, and it only holds while those stay open.
						</p>
					</li>
				</ul>
			</div>
		</div>
	</section>
</Layout>
