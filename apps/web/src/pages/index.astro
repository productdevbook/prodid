---
import CodeSample from '@/components/code-sample.astro'
import Layout from '@/layouts/base.astro'
import { CONTACT, examples, SPEC_STATUS } from '@/lib/spec'

const DESCRIPTION =
	'prodid gives every physical product a permanent open identifier. GTIN, MPN and every other code resolve to it, and every fact is a claim attributed to its source.'

interface ExampleClaim {
	property: string
	value: unknown
	lang?: string
	source: { name: string; trust: string; lapsed: boolean }
	seen_at: string
}

interface ExampleEntity {
	opid: string
	parents: { family: string; variant: string }
	identifiers: { scheme: string; value: string; scope?: string }[]
	claims: ExampleClaim[]
}

const entity = JSON.parse(examples.entityItem) as ExampleEntity

function show(value: unknown): string {
	if (typeof value === 'string') return value
	if (typeof value === 'object' && value !== null && 'value' in value && 'unit' in value) {
		const measured = value as { value: number; unit: string }
		return `${measured.value} ${measured.unit}`
	}
	if (typeof value === 'object' && value !== null && 'kind' in value && 'license' in value) {
		const media = value as { kind: string; license: string }
		return `${media.kind} · ${media.license}`
	}
	return JSON.stringify(value)
}

const markets = entity.claims.filter((claim) => claim.property === 'markets').map((claim) => show(claim.value))
const rows = [
	...entity.claims.filter((claim) => claim.property !== 'markets'),
	...(markets.length > 0 ? [{ ...entity.claims.find((claim) => claim.property === 'markets')!, value: markets.join(', ') }] : []),
]
	.map((claim) => ({
		property: claim.property.replace(/^properties\./, ''),
		value: show(claim.value),
		source: claim.source.name,
		trust: claim.source.trust,
		lapsed: claim.source.lapsed,
		seen: claim.seen_at.slice(0, 10),
	}))
	.sort((a, b) => Number(a.lapsed) - Number(b.lapsed))

const heroRows = [
	rows.find((row) => row.property === 'material'),
	rows.find((row) => row.property === 'weight'),
	rows.find((row) => row.lapsed),
].filter((row) => row !== undefined)

const brand = rows.find((row) => row.property === 'brand')?.value ?? ''
const name = rows.find((row) => row.property === 'name' && !row.lapsed)?.value ?? ''
const gtin = entity.identifiers.find((identifier) => identifier.scheme === 'gtin')?.value ?? ''

const codes = [
	{ value: gtin, note: 'retail unit for DE and TR' },
	{ value: 'another GTIN', note: 'the same jacket in a two-pack' },
	{ value: 'another GTIN', note: 'next year’s packaging' },
	{ value: 'TJ-2041-NVY-M', note: 'manufacturer part number' },
]

const model = [
	{ kind: 'family', opid: entity.parents.family, title: 'Acme Trail Jacket', note: 'The product as people talk about it.' },
	{ kind: 'variant', opid: entity.parents.variant, title: 'navy · size M', note: 'One combination of colour, size and the like.' },
	{ kind: 'item', opid: entity.opid, title: 'Retail unit for DE and TR', note: 'The thing that carries a barcode.' },
]

const trust = [
	{ level: 'authoritative', meaning: 'Controls the domain and is confirmed as the brand owner.' },
	{ level: 'verified', meaning: 'Proved control of a domain through DNS or its own website.' },
	{ level: 'unverified', meaning: 'A hosted name without a domain, a dataset, or a contribution.' },
]

const audiences = [
	{
		title: 'Manufacturers',
		body: 'State your product data once, on your own domain. No reseller listing or marketplace owns the description of what you make.',
	},
	{
		title: 'E-commerce, ERP and PIM vendors',
		body: 'One discovery document and one feed per merchant domain, generated from data you already hold.',
	},
	{
		title: 'Developers',
		body: 'Resolve any code to an identifier that survives repackaging. Every fact says who said it, when, and whether that source still stands behind it.',
	},
]

const request = `GET /01/${gtin} HTTP/1.1
Host: prodid.org
Accept: application/json

HTTP/1.1 200 OK
Content-Type: application/json
Content-Location: /id/${entity.opid}`

const eyebrow = 'font-mono text-xs tracking-[0.18em] text-accent uppercase'
const heading = 'mt-4 text-2xl font-semibold tracking-tight text-balance sm:text-[2.1rem] sm:leading-[1.15]'
---

<Layout title="prodid — open identity for every physical product" description={DESCRIPTION}>
	<section class="shell grid items-center gap-12 pt-14 pb-16 sm:pt-20 sm:pb-24 lg:grid-cols-[1.05fr_1fr] [&>*]:min-w-0">
		<div>
			<p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1.5 text-xs text-soft">
				<span class="size-2 rounded-full bg-ok" aria-hidden="true"></span>
				Spec v1 · live
			</p>
			<h1 class="mt-6 text-[2.3rem] leading-[1.06] font-semibold tracking-tight sm:text-[3.4rem]">
				A barcode is not a product. <span class="text-accent">prodid is.</span>
			</h1>
			<p class="mt-6 max-w-xl text-lg leading-relaxed text-soft">
				A permanent, open identifier for every physical product. Every barcode and part number resolves to it, and every fact
				about it names the source that said it.
			</p>
			<div class="mt-9 flex flex-wrap gap-3">
				<a
					href="/publish"
					class="inline-flex min-h-11 items-center rounded-md bg-ink px-5 text-sm font-medium text-bg transition-opacity hover:opacity-85"
				>
					Publish your products
				</a>
				<a
					href="/spec"
					class="inline-flex min-h-11 items-center rounded-md border border-rule bg-surface px-5 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
				>
					Read the specification
				</a>
			</div>
		</div>

		<figure class="w-full">
			<div class="overflow-hidden rounded-xl border border-line bg-surface shadow-[0_1px_2px_rgb(0_0_0/0.04),0_8px_24px_-12px_rgb(0_0_0/0.12)]">
				<div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-line bg-sunken px-4 py-3 font-mono text-xs text-soft">
					<span>prodid.org/01/{gtin}</span>
					<span>→ /id/{entity.opid}</span>
				</div>
				<div class="flex items-start gap-4 px-4 py-5 sm:px-5">
					<div class="grid size-16 shrink-0 place-items-center rounded-lg bg-accent-bg text-accent" aria-hidden="true">
						<svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="1.6">
							<path d="M8 3 4 6v4l2 1v10h12V11l2-1V6l-4-3-2 2h-4L8 3Z" stroke-linejoin="round"></path>
						</svg>
					</div>
					<div class="min-w-0">
						<p class="text-xs tracking-wider text-soft uppercase">Item · {brand}</p>
						<p class="mt-1 text-xl font-semibold tracking-tight">{name}</p>
						<p class="mt-1 text-sm text-soft">navy · M · sold in {markets.join(', ')}</p>
					</div>
				</div>
				<ul class="border-t border-line text-sm">
					{
						heroRows.map((row) => (
							<li
								class:list={[
									'grid grid-cols-[6.5rem_minmax(0,1fr)] items-baseline gap-x-3 gap-y-1 border-b border-line px-4 py-3 last:border-b-0 sm:grid-cols-[6.5rem_minmax(0,1fr)_auto] sm:px-5',
									row.lapsed && 'bg-warn-bg',
								]}
							>
								<span class="font-mono text-xs text-soft">{row.property}</span>
								<span class:list={[row.lapsed && 'text-soft line-through']}>{row.value}</span>
								<span class:list={['col-start-2 text-xs sm:col-start-auto', row.lapsed ? 'text-warn' : 'text-ok']}>
									{row.lapsed ? `lapsed · ${row.source}` : `✓ ${row.source}`}
								</span>
							</li>
						))
					}
				</ul>
			</div>
			<figcaption class="mt-3 text-sm text-soft">
				What scanning the code on the label returns. The record is the specification’s own example.
			</figcaption>
		</figure>
	</section>

	<section aria-labelledby="problem" class="border-y border-line bg-surface">
		<div class="shell grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-[1fr_1.15fr] [&>*]:min-w-0">
			<div>
				<p class={eyebrow}>The problem</p>
				<h2 id="problem" class={heading}>Four codes, one jacket, and nothing joining them.</h2>
				<p class="mt-5 text-base leading-relaxed text-soft sm:text-lg">
					A product gets a new barcode for every market, pack size and packaging change, and its data sits in a different
					system for each one. When two of them disagree, one is quietly overwritten.
				</p>
				<p class="mt-4 text-base leading-relaxed text-soft sm:text-lg">
					prodid gives the product itself an identifier that does not change when the barcode does.
				</p>
			</div>

			<figure aria-label="Several codes resolving to one variant" class="flex flex-col items-stretch gap-4 sm:flex-row sm:items-center">
				<ul class="grid flex-1 gap-2.5">
					{
						codes.map((code) => (
							<li class="rounded-lg border border-line bg-bg px-4 py-3">
								<p class:list={['font-mono text-sm', code.value === 'another GTIN' && 'text-soft italic']}>{code.value}</p>
								<p class="mt-0.5 text-xs text-soft">{code.note}</p>
							</li>
						))
					}
				</ul>
				<svg viewBox="0 0 48 24" class="h-6 w-12 shrink-0 rotate-90 self-center text-accent sm:rotate-0" aria-hidden="true">
					<path d="M2 12h40m-9-9 9 9-9 9" fill="none" stroke="currentColor" stroke-width="2"></path>
				</svg>
				<div class="flex-1 rounded-xl border-2 border-accent bg-accent-bg p-5">
					<p class="text-xs tracking-wider text-accent uppercase">One variant</p>
					<p class="mt-2 font-mono text-lg font-medium">{entity.parents.variant}</p>
					<p class="mt-2 text-sm leading-relaxed text-soft">Never reused, never deleted. Every code that ever pointed here keeps working.</p>
				</div>
			</figure>
		</div>
	</section>

	<section aria-labelledby="model" class="shell py-16 sm:py-24">
		<div class="max-w-2xl">
			<p class={eyebrow}>The model</p>
			<h2 id="model" class={heading}>Family, variant, item. Codes point at them; they are not them.</h2>
			<p class="mt-5 text-base leading-relaxed text-soft sm:text-lg">
				Each level has its own <code class="chip">opid</code>: 16 characters that encode nothing, so nothing about the product
				can make them wrong.
			</p>
		</div>

		<ol class="mt-10 grid gap-3 md:grid-cols-[1fr_auto_1fr_auto_1fr] md:items-stretch [&>*]:min-w-0">
			{
				model.map((level, index) => (
					<>
						{index > 0 && (
							<li aria-hidden="true" class="grid place-items-center text-rule">
								<svg viewBox="0 0 24 24" class="size-5 rotate-90 md:rotate-0" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M5 12h14m-6-6 6 6-6 6"></path>
								</svg>
							</li>
						)}
						<li class:list={['rounded-xl border bg-surface p-5', index === 2 ? 'border-accent' : 'border-line']}>
							<p class="font-mono text-xs text-soft">
								<span class="tracking-wider uppercase">{level.kind}</span> · {level.opid}
							</p>
							<p class="mt-3 text-lg font-semibold tracking-tight">{level.title}</p>
							<p class="mt-1.5 text-sm leading-relaxed text-soft">{level.note}</p>
							{index === 2 && (
								<ul class="mt-4 grid gap-1.5 border-t border-line pt-4 [&>*]:min-w-0">
									{entity.identifiers.map((identifier) => (
										<li class="flex flex-wrap items-baseline gap-x-2 text-sm">
											<span class="w-10 shrink-0 font-mono text-[0.7rem] tracking-wider text-soft uppercase">{identifier.scheme}</span>
											<span class="font-mono text-[0.8125rem] break-all">{identifier.value}</span>
										</li>
									))}
								</ul>
							)}
						</li>
					</>
				))
			}
		</ol>
		<p class="mt-5 max-w-2xl text-sm leading-relaxed text-soft">
			New packaging adds a new item with a new barcode, under the same variant and the same family. Nothing that pointed at the
			old one breaks.
		</p>
	</section>

	<section id="how" aria-labelledby="how-heading" class="border-y border-line bg-[oklch(0.2_0.01_265)] text-[oklch(0.95_0.005_85)]">
		<div class="shell py-16 sm:py-24">
			<p class="font-mono text-xs tracking-[0.18em] uppercase opacity-70">How it works</p>
			<h2 id="how-heading" class={heading}>Publish on your domain. prodid indexes it. Anyone resolves it.</h2>

			<ol class="mt-12 grid gap-4 lg:grid-cols-3 [&>*]:min-w-0">
				<li class="flex flex-col rounded-xl border border-white/15 p-6">
					<p class="font-mono text-xs opacity-70">01 · Publish</p>
					<p class="mt-3 text-lg font-semibold">Three things on your domain</p>
					<ul class="mt-4 grid gap-2 font-mono text-[0.8125rem] [&>*]:min-w-0">
						<li class="rounded-md bg-white/10 px-3 py-2 break-all">/.well-known/prodid.json</li>
						<li class="rounded-md bg-white/10 px-3 py-2 break-all">/prodid/items.ndjson</li>
						<li class="rounded-md bg-white/10 px-3 py-2 break-all">_prodid TXT "v=prodid0; host=…"</li>
					</ul>
					<p class="mt-4 flex-1 text-sm leading-relaxed opacity-75">
						A discovery document, a feed with one product per line, and a DNS record that proves the domain is yours.
					</p>
					<a href="/publish" class="mt-5 text-sm font-medium underline-offset-4 hover:underline">How to publish →</a>
				</li>
				<li class="flex flex-col rounded-xl border border-white/15 p-6">
					<p class="font-mono text-xs opacity-70">02 · Index</p>
					<p class="mt-3 text-lg font-semibold">Checked, matched, attributed</p>
					<ul class="mt-4 grid gap-2 text-sm [&>*]:min-w-0">
						<li class="flex items-center gap-2"><span aria-hidden="true">✓</span> every line validated against the schema</li>
						<li class="flex items-center gap-2"><span aria-hidden="true">✓</span> matched to an existing opid, or a new one</li>
						<li class="flex items-center gap-2"><span aria-hidden="true">✓</span> each field stored as a claim by your domain</li>
					</ul>
					<p class="mt-4 flex-1 text-sm leading-relaxed opacity-75">
						Retailers, registries and open datasets are sources the same way: beside the maker, never on top of it.
					</p>
					<a href="/spec#claims" class="mt-5 text-sm font-medium underline-offset-4 hover:underline">How claims work →</a>
				</li>
				<li class="flex flex-col rounded-xl border border-white/15 p-6">
					<p class="font-mono text-xs opacity-70">03 · Resolve</p>
					<p class="mt-3 text-lg font-semibold">One URL, printed on the product</p>
					<div class="mt-4 grid gap-2 text-sm">
						<p class="rounded-md bg-white/10 px-3 py-2 font-mono text-[0.8125rem] break-all">prodid.org/01/{gtin}</p>
						<div class="grid grid-cols-2 gap-2">
							<p class="rounded-md border border-white/15 px-3 py-2">Browser → a page</p>
							<p class="rounded-md border border-white/15 px-3 py-2">API → the JSON record</p>
						</div>
					</div>
					<p class="mt-4 flex-1 text-sm leading-relaxed opacity-75">
						The path is GS1 Digital Link syntax, so it can be the QR code on the label itself.
					</p>
					<a href="/spec#the-resolver" class="mt-5 text-sm font-medium underline-offset-4 hover:underline">How resolving works →</a>
				</li>
			</ol>
		</div>
	</section>

	<section aria-labelledby="claims" class="shell py-16 sm:py-24">
		<div class="max-w-2xl">
			<p class={eyebrow}>Claims</p>
			<h2 id="claims" class={heading}>Every fact names its source. Disagreement stays visible.</h2>
			<p class="mt-5 text-base leading-relaxed text-soft sm:text-lg">
				Nothing is merged into one “truth”. When a source stops publishing, its claims are kept and marked lapsed, not deleted.
			</p>
		</div>

		<div class="mt-10 overflow-x-auto rounded-xl border border-line bg-surface">
			<table class="w-full min-w-[40rem] text-left text-sm">
				<caption class="sr-only">The claims in the specification’s example item</caption>
				<thead class="bg-sunken text-xs tracking-wider text-soft uppercase">
					<tr>
						<th scope="col" class="px-4 py-3 font-medium">Property</th>
						<th scope="col" class="px-4 py-3 font-medium">Value</th>
						<th scope="col" class="px-4 py-3 font-medium">Source</th>
						<th scope="col" class="px-4 py-3 font-medium">Trust</th>
						<th scope="col" class="px-4 py-3 font-medium">Seen</th>
					</tr>
				</thead>
				<tbody>
					{
						rows.map((row) => (
							<tr class:list={['border-t border-line', row.lapsed && 'bg-warn-bg']}>
								<td class="px-4 py-3 font-mono text-[0.8125rem]">{row.property}</td>
								<td class:list={['px-4 py-3', row.lapsed && 'text-soft line-through']}>{row.value}</td>
								<td class="px-4 py-3">{row.source}</td>
								<td class:list={['px-4 py-3 font-medium', row.lapsed || row.trust === 'unverified' ? 'text-warn' : 'text-ok']}>
									{row.trust}
									{row.lapsed && ' · lapsed'}
								</td>
								<td class="px-4 py-3 whitespace-nowrap text-soft">{row.seen}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>

		<dl class="mt-8 grid gap-6 sm:grid-cols-3 [&>*]:min-w-0">
			{
				trust.map((entry) => (
					<div>
						<dt class="font-mono text-sm font-medium">{entry.level}</dt>
						<dd class="mt-1.5 text-sm leading-relaxed text-soft">{entry.meaning}</dd>
					</div>
				))
			}
		</dl>

		<details class="group mt-10 max-w-3xl rounded-xl border border-line bg-surface">
			<summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 px-5 text-sm font-medium">
				See the request and the full JSON record
				<span class="text-soft transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
			</summary>
			<div class="grid gap-4 border-t border-line p-4 sm:p-5 [&>*]:min-w-0">
				<CodeSample code={request} lang="http" label="Request and response headers" />
				<CodeSample code={examples.entityItem} lang="json" label="spec/fixtures/v1/examples/entity.item.json" badge="application/json" scroll />
			</div>
		</details>
	</section>

	<section aria-labelledby="who" class="border-t border-line bg-surface">
		<div class="shell py-16 sm:py-24">
			<p class={eyebrow}>Who it is for</p>
			<h2 id="who" class={heading}>The people who make the data, and the people who need it.</h2>
			<div class="mt-10 grid gap-10 md:grid-cols-3 [&>*]:min-w-0">
				{
					audiences.map((audience) => (
						<div class="border-t-2 border-ink pt-5">
							<h3 class="text-base font-semibold tracking-tight">{audience.title}</h3>
							<p class="mt-3 text-[0.9375rem] leading-relaxed text-soft">{audience.body}</p>
						</div>
					))
				}
			</div>
			<p class="mt-12 max-w-3xl rounded-lg border border-line bg-bg p-5 text-sm leading-relaxed text-soft">
				<strong class="font-medium text-ink">On the EU Digital Product Passport.</strong> ESPR asks for a passport reachable from a
				data carrier on the product, and GS1 Digital Link is one of the carrier syntaxes being standardised for it. prodid is not a
				passport service and publishing here is not compliance with anything; it is the same groundwork: one machine-readable
				record per product, at a stable address you control.
			</p>
		</div>
	</section>

	<section aria-labelledby="status" class="border-t border-line">
		<div class="shell grid gap-10 py-16 sm:py-20 lg:grid-cols-[1fr_2fr] [&>*]:min-w-0">
			<div>
				<p class={eyebrow}>Status</p>
				<h2 id="status" class={heading}>Where this actually stands.</h2>
				<p class="mt-5 text-[0.9375rem] leading-relaxed text-soft">{SPEC_STATUS}</p>
			</div>
			<ul class="divide-y divide-line">
				<li class="grid gap-1 py-5 sm:grid-cols-[8rem_1fr] sm:gap-4">
					<span class="text-sm font-medium text-ok">Stable</span>
					<p class="text-[0.9375rem] leading-relaxed">
						<strong class="font-semibold">Specification v1.</strong>{' '}
						<span class="text-soft"
							>It changes only by addition; anything else would be v2. A v0 discovery document is accepted until
							2027-01-26 00:00 UTC. <a
								href="/spec"
								class="rounded-sm text-accent underline underline-offset-4">Read it</a
							> and <a href={CONTACT.issues} class="rounded-sm text-accent underline underline-offset-4"
								>say where it is wrong</a
							>.</span
						>
					</p>
				</li>
				<li class="grid gap-1 py-5 sm:grid-cols-[8rem_1fr] sm:gap-4">
					<span class="text-sm font-medium text-soft">Canary and one dataset</span>
					<p class="text-[0.9375rem] leading-relaxed">
						<strong class="font-semibold">No publisher’s catalogue is indexed yet.</strong>{' '}
						<span class="text-soft"
							>The index holds two sources: the project's own canary, <a
								href="https://prodid.org/source/canary.prodid.org"
								class="rounded-sm text-accent underline underline-offset-4">canary.prodid.org</a
							>, which proves publishing, crawling and resolving end to end, and <a
								href="https://prodid.org/source/dataset:wikidata"
								class="rounded-sm text-accent underline underline-offset-4">dataset:wikidata</a
							>, a bounded test import of 5 Wikidata items, unverified and under CC0-1.0.</span
						>
					</p>
				</li>
				<li class="grid gap-1 py-5 sm:grid-cols-[8rem_1fr] sm:gap-4">
					<span class="text-sm font-medium text-soft">By design</span>
					<p class="text-[0.9375rem] leading-relaxed">
						<strong class="font-semibold">The index is replaceable.</strong>{' '}
						<span class="text-soft"
							>The spec, the schemas, the opids and the code mappings are <a
								href="/spec#licensing"
								class="rounded-sm text-accent underline underline-offset-4">CC0</a
							>. Each claim keeps its source’s licence. The facts live on the domains that publish them, so anyone can crawl them
							again and printed codes keep their meaning.</span
						>
					</p>
				</li>
			</ul>
		</div>
	</section>
</Layout>
