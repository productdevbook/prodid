---
import CodeSample from '@/components/code-sample.astro'
import PageHeader from '@/components/page-header.astro'
import Layout from '@/layouts/base.astro'
import { examples } from '@/lib/spec'

const DESCRIPTION =
	'How a manufacturer or a software vendor publishes product data to prodid: the discovery document, the NDJSON feed, the one DNS TXT record that holds the identity, and the ping.'

const routes = [
	{
		n: '1',
		when: 'You can serve files on your own domain.',
		who: 'A brand with an IT team, or a platform — e-commerce, ERP, PIM — publishing for every merchant it hosts.',
		how: 'Serve the discovery document on the domain, and publish a TXT record naming the domain itself.',
		identity: 'the domain',
		trust: 'verified',
		href: '#own-domain',
		ready: true,
	},
	{
		n: '2',
		when: 'You own a domain but cannot serve files from it.',
		who: 'A manufacturer whose website is on a platform it does not control.',
		how: 'Publish at a hosted slug and point one TXT record on your domain at that host.',
		identity: 'the domain, proven by DNS',
		trust: 'verified',
		href: '#delegated',
		ready: false,
	},
	{
		n: '3',
		when: 'You have no domain at all.',
		who: 'A small producer or a cooperative.',
		how: 'Publish at a hosted slug. Add a domain later without losing anything.',
		identity: 'the slug host',
		trust: 'unverified',
		href: '#hosted',
		ready: false,
	},
]

const feedFields = [
	{ field: '$type', required: 'yes', note: 'Always org.prodid.feed.' },
	{ field: 'version', required: 'yes', note: '0 while the specification is a draft.' },
	{ field: 'publisher.name', required: 'yes', note: 'The name a person should see next to your claims.' },
	{
		field: 'publisher.contact',
		required: 'no',
		note: 'An email address someone actually reads. It is where the index writes when your source lapses, which is the only warning you get.',
	},
	{ field: 'license', required: 'yes', note: 'SPDX identifier covering the facts in your feeds, such as CC0-1.0.' },
	{ field: 'feeds', required: 'yes', note: 'Up to 100 https URLs, every one on the same host as this document.' },
	{
		field: 'domain',
		required: 'when delegating',
		note: 'The domain this document speaks for. Required whenever the document is reached through a TXT record naming some other host, and then it must equal that domain. Optional when the domain serves the document itself, and if present it must still match.',
	},
]

const itemFields = [
	{ field: '$type', required: 'yes', note: 'Always org.prodid.item.' },
	{
		field: 'key',
		required: 'yes',
		note: 'Your stable name for this record inside the feed. Publishing the same key again replaces it.',
	},
	{
		field: 'brand',
		required: 'yes',
		note: 'The brand as it appears on the product. It is normalized before it scopes an mpn, so ARÇELİK and Arçelik are one brand, not two.',
	},
	{ field: 'name', required: 'yes', note: 'The product name, without the variant axes.' },
	{
		field: 'identifiers',
		required: 'yes',
		note: 'At least one { scheme, value }, and at least one the index can store. Values carry no whitespace at either end and are not blank. A gtin must be 8, 12, 13 or 14 digits with a correct check digit and not all zeros; an mpn needs a brand that normalizes to something, because that is the scope it is unique within; a restricted-circulation gtin is kept, but only as your own rcn. A record left with nothing storable identifies nothing and is skipped.',
	},
	{ field: 'lang', required: 'no', note: 'BCP 47 tag for the human-readable text in this record.' },
	{ field: 'group', required: 'no', note: 'Your own grouping key. Items that share one are variants of a single family.' },
	{ field: 'variant', required: 'no', note: 'The axes that distinguish this item within the group: color, size, capacity.' },
	{ field: 'category', required: 'no', note: 'GS1 GPC brick code, written gpc: followed by eight digits.' },
	{ field: 'markets', required: 'no', note: 'ISO 3166-1 alpha-2 codes of the markets this item is sold in.' },
	{ field: 'properties', required: 'no', note: 'Strings, numbers, booleans, lists, or { value, unit } for a measurement.' },
	{
		field: 'media',
		required: 'no',
		note: 'Up to 20 https URLs, each with a kind and an SPDX license from the ingestible list. Unlike feeds, these may be on any host.',
	},
]

const trust = [
	{ level: 'authoritative', meaning: 'Domain control proven and ownership of the brand confirmed.' },
	{ level: 'verified', meaning: 'Domain control proven, by the TXT record or by the domain serving the document.' },
	{ level: 'unverified', meaning: 'A hosted slug with no domain, a dataset import, or a community contribution.' },
]

const txtRecord = `_prodid.acme.example. IN TXT "v=prodid0; host=acme.example"`

const txtDelegated = `_prodid.acme.example. IN TXT "v=prodid0; host=acme.prodid.org"`

const ping = `curl -X POST https://prodid.org/ping \\
  -H 'content-type: application/json' \\
  -d '{"domain": "acme.example"}'

HTTP/1.1 202 Accepted
Content-Type: application/json

{"status":"accepted"}`

const wellKnown = 'https://acme.example/.well-known/prodid.json'

const mediaCaps = [
	{ what: 'One image', cap: '20 MiB' },
	{ what: 'One document', cap: '50 MiB' },
	{ what: 'One media fetch', cap: '60 s' },
	{ what: 'Media entries in one record', cap: '20' },
]

const mediaLicences = `CC0-1.0  CC-BY-4.0  CC-BY-SA-4.0  CC-BY-ND-4.0
CC-BY-3.0  CC-BY-SA-3.0  CC-BY-ND-3.0`

const checklist = [
	'Discovery answers with HTTP 200, a JSON content type and a body that validates against the feed schema — not an HTML “page not found” served with a 200.',
	'There is exactly one v=prodid0 TXT record at _prodid.<your domain>. Two is an error, and a malformed one is an error.',
	'That record is v=prodid0; host=<hostname>. A host, never a URL: no scheme, no port, no path.',
	'Every URL in feeds is https and on the same host as the discovery document that lists it.',
	'Every URL in feeds is one you still serve. A feed that cannot be fetched fails the whole crawl, and seven days of that lapses the source.',
	'A delegated document carries "domain", equal to the domain it speaks for.',
	'The discovery document is served as application/json and does not redirect to another host.',
	'Feeds and documents send ETag or Last-Modified, so an unchanged file costs a 304.',
	'Every feed line is one complete JSON object under 64 KiB, UTF-8, newline separated, no array wrapper and no trailing commas.',
	'Every key is stable and is never reused for a different product.',
	'Every gtin is digits only, with a correct check digit, and is not all zeros.',
	'Every identifier value is trimmed — no leading or trailing whitespace — and every record keeps at least one identifier the index can store, which means an mpn needs a brand.',
	'Every media entry has a kind that matches its actual bytes and one of the seven ingestible SPDX licences, or that entry is skipped.',
	'No record contains an opid. The index assigns those.',
	'publisher.contact is an address somebody reads.',
]
---

<Layout title="Publish your products — prodid" description={DESCRIPTION} active="publish">
	<PageHeader
		eyebrow="Publisher guide"
		title="Publish your products"
		lead="Publishing to prodid means putting two files on the web and one record in DNS. On your own domain there is nothing to sign up for and no key to keep: the domain is the credential, and you change or withdraw what you publish by changing the files."
	/>

	<section aria-labelledby="discovery" class="border-t border-line">
		<div class="shell py-14 sm:py-16">
			<div class="max-w-3xl">
				<h2 id="discovery" class="text-2xl font-semibold tracking-tight">How the index finds you</h2>
				<p class="mt-5 text-base leading-relaxed text-soft sm:text-lg">
					Worth knowing before anything else, because it decides which of the three routes below is yours. Discovery runs
					from scratch on every crawl, DNS first, and nothing about the path to your data is remembered between crawls.
				</p>
			</div>

			<ol class="mt-9 grid max-w-3xl gap-px overflow-hidden rounded-xl border border-line bg-line [&>*]:min-w-0">
				<li class="bg-surface p-6">
					<p class="font-mono text-xs text-soft">First</p>
					<h3 class="mt-2 text-base font-semibold tracking-tight">
						A DNS TXT record at <code class="chip">_prodid.acme.example</code>
					</h3>
					<p class="mt-3 text-[0.9375rem] leading-relaxed text-soft">
						If a <code class="chip">v=prodid0</code> record is there it is followed exclusively, even when it names your
						own domain. The record names a <em>host</em>; the document is always{' '}
						<code class="chip">https://&lt;host&gt;/.well-known/prodid.json</code>.
					</p>
				</li>
				<li class="bg-surface p-6">
					<p class="font-mono text-xs text-soft">Only if there is no such record</p>
					<h3 class="mt-2 text-base font-semibold tracking-tight">
						<code class="chip">{wellKnown}</code>
					</h3>
					<p class="mt-3 text-[0.9375rem] leading-relaxed text-soft">
						The document on the domain itself. Whoever serves the domain over HTTPS speaks for it.
					</p>
				</li>
			</ol>

			<div class="mt-8 max-w-3xl">
				<p class="text-base leading-relaxed text-soft">
					DNS comes first because it is the stronger proof: whoever can put a file on a host is not always who owns the
					domain, and the owner has to be able to override that. Which is also why you should write the record even when
					you serve the file yourself — <a href="#own-domain" class="rounded-sm text-accent underline underline-offset-4">
						route 1, step 3</a
					> explains what it buys you.
				</p>
			</div>

			<div class="mt-8 grid max-w-3xl gap-4 [&>*]:min-w-0">
				<p class="rounded-lg border border-line bg-surface p-5 text-[0.9375rem] leading-relaxed text-soft">
					<strong class="font-medium text-ink">Exactly one record, and nothing behind it.</strong> More than one{' '}
					<code class="chip">v=prodid0</code> record at that name is an error, not a choice between them, and a single
					malformed or over-long one is an error too. There is no fallback: once a record exists, a record that does not
					work ends discovery rather than sending the crawler to look at your domain instead. If you are moving hosts,
					replace the record — never add a second. The grammar, with test vectors, is in the{' '}
					<a href="/spec#the-_prodid-txt-record" class="rounded-sm text-accent underline underline-offset-4">
						specification</a
					>.
				</p>
				<p class="rounded-lg border border-line bg-surface p-5 text-[0.9375rem] leading-relaxed text-soft">
					<strong class="font-medium text-ink">What counts as an answer.</strong> HTTP 200 after at most one redirect, a
					JSON content type, a body that validates against the feed schema, and a <code class="chip">domain</code> that
					names the domain being discovered. A site that answers unknown paths with an HTML page and a 200 is not
					answering, and neither is a document served as <code class="chip">text/html</code>.
				</p>
			</div>
		</div>
	</section>

	<section aria-labelledby="routes" class="border-t border-line">
		<div class="shell py-14 sm:py-16">
			<div class="max-w-3xl">
				<h2 id="routes" class="text-2xl font-semibold tracking-tight">Choose how you publish</h2>
				<p class="mt-5 text-base leading-relaxed text-soft sm:text-lg">
					Identity and hosting are separate. Your identity is a domain you control; where the documents are actually
					served is a detail you can change later without changing your identity or any identifier prodid has assigned to
					your products. Three routes, all producing exactly the same records.
				</p>
			</div>
			<ol class="mt-10 grid gap-px overflow-hidden rounded-xl border border-line bg-line lg:grid-cols-3 [&>*]:min-w-0">
				{
					routes.map((route) => (
						<li class="flex flex-col bg-surface p-6">
							<div class="flex min-h-[1.5rem] items-center justify-between gap-3">
								<p class="font-mono text-xs text-soft">Route {route.n}</p>
								{!route.ready && (
									<span class="rounded-full border border-rule px-2 py-0.5 text-[0.65rem] font-semibold tracking-wider text-soft uppercase">
										Not available yet
									</span>
								)}
							</div>
							<h3 class="mt-3 text-base font-semibold tracking-tight">{route.when}</h3>
							<p class="mt-3 text-[0.9375rem] leading-relaxed text-soft">{route.who}</p>
							<p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-soft">{route.how}</p>
							<dl class="mt-5 grid gap-1.5 border-t border-line pt-4 text-[0.8125rem]">
								<div class="flex gap-2">
									<dt class="w-16 shrink-0 text-soft">Identity</dt>
									<dd>{route.identity}</dd>
								</div>
								<div class="flex gap-2">
									<dt class="w-16 shrink-0 text-soft">Trust</dt>
									<dd class="font-mono">{route.trust}</dd>
								</div>
							</dl>
							<a href={route.href} class="mt-5 rounded-sm text-sm font-medium text-accent underline-offset-4 hover:underline">
								Route {route.n} in detail →
							</a>
						</li>
					))
				}
			</ol>
			<p class="mt-6 max-w-3xl text-[0.9375rem] leading-relaxed text-soft">
				Routes 2 and 3 need the hosted publishing service at <code class="chip">&lt;slug&gt;.prodid.org</code>, which runs
				but has no self-service sign-up yet: an operator sets each site up. Route 1 is the one you can do on your own.
			</p>
		</div>
	</section>

	<section aria-labelledby="own-domain" class="border-t border-line">
		<div class="shell py-14 sm:py-16">
			<div class="max-w-3xl">
				<p class="font-mono text-xs tracking-[0.18em] text-soft uppercase">Route 1</p>
				<h2 id="own-domain" class="mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">
					Publish on your own domain
				</h2>
				<p class="mt-5 text-base leading-relaxed text-soft sm:text-lg">
					Two files and one DNS record. A platform publishing on behalf of merchants does the same thing on each merchant
					domain, so every merchant keeps its own identity and its own trust level.
				</p>
			</div>

			<div class="mt-12 grid gap-12 [&>*]:min-w-0">
				<div>
					<h3 class="text-lg font-semibold tracking-tight">Step 1 — Serve the discovery document</h3>
					<p class="mt-3 max-w-3xl text-base leading-relaxed text-soft">
						One file, at a fixed path, listing where your product feeds are:{' '}
						<code class="chip">{wellKnown}</code>
					</p>
					<div class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-start [&>*]:min-w-0">
						<CodeSample
							code={examples.feed}
							lang="json"
							label=".well-known/prodid.json"
							badge="application/json"
							caption="The example from spec/examples/prodid.json, rendered from the file itself."
						/>
						<div class="table-scroll" role="region" aria-label="Discovery document fields" tabindex="0">
							<table class="data-table">
								<thead>
									<tr><th scope="col">Field</th><th scope="col">Required</th><th scope="col">What it is</th></tr>
								</thead>
								<tbody>
									{
										feedFields.map((row) => (
											<tr>
												<td class="font-mono text-[0.8125rem] whitespace-nowrap">{row.field}</td>
												<td class="text-soft whitespace-nowrap">{row.required}</td>
												<td class="text-soft">{row.note}</td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>
					</div>
					<p class="mt-5 max-w-3xl text-[0.9375rem] leading-relaxed text-soft">
						Serve it over HTTPS on the default port, with a valid certificate, as{' '}
						<code class="chip">application/json</code> — or any <code class="chip">application/…+json</code>. Do not
						redirect it to another host: the one redirect the crawler follows is <code class="chip">acme.example</code>{' '}
						to <code class="chip">www.acme.example</code>.
					</p>
				</div>

				<div>
					<h3 class="text-lg font-semibold tracking-tight">Step 2 — Serve the feed</h3>
					<p class="mt-3 max-w-3xl text-base leading-relaxed text-soft">
						A feed is NDJSON: one complete JSON object per line, UTF-8, newline separated. No array around it, no commas
						between lines. That way a feed of two million products streams line by line, and one bad line costs you that
						line rather than the rest.
					</p>
					<CodeSample
						class="mt-6"
						code={examples.items}
						lang="jsonl"
						label="prodid/items.ndjson"
						badge="application/x-ndjson"
						caption="Three variants of one product, from spec/examples/items.ndjson. They share a group, so the index builds one family with three variants from them."
					/>
					<p class="mt-6 max-w-3xl rounded-lg border border-line bg-surface p-5 text-[0.9375rem] leading-relaxed text-soft">
						<strong class="font-medium text-ink">Feeds live on the same host as the document that lists them.</strong> A
						discovery document naming a feed on another host is rejected whole, not in part — you lose the whole source,
						not one feed, and it counts as a definite negative, so it starts the lapse clock below. Serving the JSON from
						your site and the NDJSON from a separate CDN hostname is a normal thing to want and it is not supported in v0.
						Put both on one host.
					</p>
					<p class="mt-8 max-w-3xl text-base leading-relaxed text-soft">The first of those lines, laid out to read:</p>
					<div class="mt-4 grid gap-8 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:items-start [&>*]:min-w-0">
						<CodeSample code={examples.itemJacket} lang="json" label="one org.prodid.item record" />
						<div class="table-scroll" role="region" aria-label="Item record fields" tabindex="0">
							<table class="data-table">
								<thead>
									<tr><th scope="col">Field</th><th scope="col">Required</th><th scope="col">What it is</th></tr>
								</thead>
								<tbody>
									{
										itemFields.map((row) => (
											<tr>
												<td class="font-mono text-[0.8125rem] whitespace-nowrap">{row.field}</td>
												<td class="text-soft whitespace-nowrap">{row.required}</td>
												<td class="text-soft">{row.note}</td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>
					</div>
					<p class="mt-6 max-w-3xl text-[0.9375rem] leading-relaxed text-soft">
						Send flat items. You never build families or variants yourself and you never send an{' '}
						<code class="chip">opid</code> — the index derives the first from <code class="chip">group</code> and assigns
						the second. If you already produce a Google Merchant feed, <code class="chip">group</code> is your{' '}
						<code class="chip">item_group_id</code>.
					</p>
					<p class="mt-4 max-w-3xl text-[0.9375rem] leading-relaxed text-soft">
						Two things about barcodes are worth knowing before you export. A <code class="chip">gtin</code> of all zeros
						is not a barcode, it is a catalogue placeholder, and a record carrying one is rejected like a bad check digit.
						A <a href="/spec#which-gtins-are-identifiers" class="rounded-sm text-accent underline underline-offset-4">
							restricted circulation number</a
						> — the in-store ranges — is stored and attributed to you, but it identifies nothing globally, so it never
						merges your product with anyone else's and <code class="chip">/01/</code> will not resolve it.
					</p>
				</div>

				<div>
					<h3 class="text-lg font-semibold tracking-tight">Step 3 — Claim the identity in DNS</h3>
					<p class="mt-3 max-w-3xl text-base leading-relaxed text-soft">
						Once the files are up, publish one record naming your own domain as the host.
					</p>
					<CodeSample class="mt-6 max-w-2xl" code={txtRecord} lang="ini" label="_prodid.acme.example TXT" />
					<p class="mt-5 max-w-3xl text-[0.9375rem] leading-relaxed text-soft">
						It points at exactly what discovery would have found anyway, so nothing about your data changes. What changes
						is what someone with add-only access to your DNS can do. With no record, a record they add takes your
						identity over silently, because DNS wins over the file. With your record already there, a second one makes
						discovery fail with <em>more than one record</em> — a lapse, which is visible, notified and recoverable.
					</p>
					<p class="mt-4 max-w-3xl rounded-lg border border-line bg-surface p-5 text-[0.9375rem] leading-relaxed text-soft">
						<strong class="font-medium text-ink">Never delegate <code class="chip">_prodid</code> to a vendor.</strong>{' '}
						Write access to <code class="chip">_prodid.&lt;domain&gt;</code> is control of your identity, exactly as it is
						for DKIM or an ACME DNS-01 challenge. A domain whose DNS is shared is an identity that is shared. Give an
						agency the feed, not the record.
					</p>
					<p class="mt-4 max-w-3xl text-[0.9375rem] leading-relaxed text-soft">
						Put the files up before the record, not after: a record pointing at a document that is not there yet is a
						failed discovery. Values are read case-insensitively and one trailing dot is fine, so{' '}
						<code class="chip">ACME.Example.</code> and <code class="chip">acme.example</code> are the same host.
					</p>
				</div>

				<div>
					<h3 class="text-lg font-semibold tracking-tight">Step 4 — Tell the index it changed</h3>
					<p class="mt-3 max-w-3xl text-base leading-relaxed text-soft">
						Optional. Every known domain is re-crawled on a schedule, and a ping only makes the next crawl happen sooner.
					</p>
					<CodeSample class="mt-6 max-w-2xl" code={ping} lang="bash" label="ask the index to run discovery now" />
					<p class="mt-4 max-w-3xl text-[0.9375rem] leading-relaxed text-soft">
						<code class="chip">{'{"domains": [...]}'}</code> takes up to 1000 at once, which is how a platform introduces
						every merchant it hosts. There is no key to send, because the ping gives the caller no say over content — and{' '}
						<code class="chip">202</code> is all it ever says. It does not tell you whether the domain was known, whether
						anything was found or whether anyone else pinged it a minute ago. A <code class="chip">429</code> means only
						that <em>you</em> are over your own request budget, and errors come back as{' '}
						<code class="chip">application/problem+json</code>. What happened to your domain shows up in your{' '}
						<a href="#after" class="rounded-sm text-accent underline underline-offset-4">source status</a>, not in the ping.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section aria-labelledby="delegated" class="border-t border-line">
		<div class="shell py-14 sm:py-16">
			<div class="max-w-3xl">
				<div class="flex flex-wrap items-center gap-3">
					<p class="font-mono text-xs tracking-[0.18em] text-soft uppercase">Route 2</p>
					<span class="rounded-full border border-rule px-2.5 py-0.5 text-[0.65rem] font-semibold tracking-wider text-soft uppercase">
						Not available yet
					</span>
				</div>
				<h2 id="delegated" class="mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">
					Delegate the hosting, keep the identity
				</h2>
				<p class="mt-5 text-base leading-relaxed text-soft sm:text-lg">
					Plenty of manufacturers own a domain and cannot put a file on it. The model is that the feed would be hosted
					somewhere else and the domain proven with DNS, so the source identity would still be the domain and the trust
					level still <code class="chip">verified</code>. The hosted service this depends on runs, but an
					operator sets each site up; there is no self-service sign-up yet.
				</p>
			</div>

			<div class="mt-10 grid max-w-3xl gap-6 [&>*]:min-w-0">
				<div class="rounded-xl border border-line bg-surface p-6">
					<h3 class="text-base font-semibold tracking-tight">What it would look like</h3>
					<ol class="mt-4 grid gap-4 text-[0.9375rem] leading-relaxed text-soft">
						<li>
							<span class="font-medium text-ink">A catalogue uploaded at a hosted slug</span> — say{' '}
							<code class="chip">acme.prodid.org</code> — which would serve both the discovery document and the feed.
						</li>
						<li>
							<span class="font-medium text-ink">One TXT record on the domain you own</span>, naming that host. A host,
							never a URL, so a record can never aim the crawler at an arbitrary address.
						</li>
						<li>
							<span class="font-medium text-ink">A document that names your domain back.</span> DNS would say{' '}
							<em>my document is over there</em>; the document would say <em>I speak for that domain</em>. A delegated
							document without <code class="chip">domain</code> is rejected — absence is never read as consent, which is
							what stops anyone pointing a record at somebody else's feed.
						</li>
					</ol>
					<CodeSample class="mt-6" code={txtDelegated} lang="ini" label="_prodid.acme.example TXT" />
					<CodeSample
						class="mt-4"
						code={examples.feedDelegated}
						lang="json"
						label="acme.prodid.org/.well-known/prodid.json"
						badge="application/json"
						caption="From spec/examples/prodid.delegated.json. The only difference from route 1 is the domain field, and here it is mandatory."
					/>
				</div>
				<p class="text-[0.9375rem] leading-relaxed text-soft">
					A hosted publisher would write <code class="chip">domain</code> into the document only after it had seen your
					TXT record itself, so there would be no window in which a document claims a domain that has not asked for it.
				</p>
			</div>
		</div>
	</section>

	<section aria-labelledby="hosted" class="border-t border-line">
		<div class="shell py-14 sm:py-16">
			<div class="max-w-3xl">
				<div class="flex flex-wrap items-center gap-3">
					<p class="font-mono text-xs tracking-[0.18em] text-soft uppercase">Route 3</p>
					<span class="rounded-full border border-rule px-2.5 py-0.5 text-[0.65rem] font-semibold tracking-wider text-soft uppercase">
						Not available yet
					</span>
				</div>
				<h2 id="hosted" class="mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">Publish without a domain</h2>
				<p class="mt-5 text-base leading-relaxed text-soft sm:text-lg">
					The model for a producer with no domain at all is a hosted slug, <code class="chip">&lt;slug&gt;.prodid.org</code>,
					publishing under its own name. The source identity would be the slug host and the trust level{' '}
					<code class="chip">unverified</code>, because nothing would have been proven about a domain. The records would
					be real records: identifiers, resolution, attribution.
				</p>
				<p class="mt-5 text-base leading-relaxed text-soft sm:text-lg">
					Most publishers in this position already keep a{' '}
					<a href="https://support.google.com/merchants/answer/7052112" class="rounded-sm text-accent underline underline-offset-4">
						Google Merchant</a
					>{' '}
					product file, so the mapping from one of those to <code class="chip">org.prodid.item</code> records is written out
					in the specification, column by column, along with what it deliberately drops: price, availability, shipping and
					condition belong to a seller on a day, not to the product.{' '}
					<a href="/spec#appendix-importing-a-merchant-feed" class="rounded-sm text-accent underline underline-offset-4">
						Importing a Merchant feed</a
					>{' '}
					is worth reading before you export, even though nothing imports it for you yet. Four things in it decide what your
					spreadsheet has to look like:
				</p>
				<ul class="mt-5 grid gap-4 [&>*]:min-w-0">
					<li class="border-l-2 border-rule pl-5 text-[0.9375rem] leading-relaxed text-soft">
						<strong class="font-medium text-ink">Four columns become variant axes</strong> —{' '}
						<code class="chip">color</code>, <code class="chip">size</code>, <code class="chip">material</code> and{' '}
						<code class="chip">pattern</code>, the ones a buyer picks between within one <code class="chip">item_group_id</code>.{' '}
						<code class="chip">gender</code>, <code class="chip">age_group</code>, <code class="chip">size_type</code> and{' '}
						<code class="chip">size_system</code> stay ordinary properties: they describe the whole group, and as axes they
						would split one product into several the first time somebody spelled one of them two ways.
					</li>
					<li class="border-l-2 border-rule pl-5 text-[0.9375rem] leading-relaxed text-soft">
						<strong class="font-medium text-ink">A repeated attribute is comma-separated or repeated-header, per file, not
						per cell.</strong> A cell is split on commas only when its header appears once in the whole file; repeat the
						header and every cell under it is taken whole. That is the only way to carry a value with a comma in it, and it is
						a decision you make once for the file. It applies to <code class="chip">additional_image_link</code>,{' '}
						<code class="chip">product_type</code>, <code class="chip">product_highlight</code>,{' '}
						<code class="chip">product_detail</code> and <code class="chip">certification</code>; everything else, a{' '}
						<code class="chip">description</code> full of commas included, is taken whole either way.
					</li>
					<li class="border-l-2 border-rule pl-5 text-[0.9375rem] leading-relaxed text-soft">
						<strong class="font-medium text-ink">A <code class="chip">product_detail</code> never overwrites anything.</strong>{' '}
						Its middle sub-attribute becomes the property key, the section name is dropped, and the first value for a key wins.
						A later detail with the same key, or one that lands on a key the mapping already produced, is dropped and reported
						with its row — so a detail column can never quietly redefine what the rest of the row said.
					</li>
					<li class="border-l-2 border-rule pl-5 text-[0.9375rem] leading-relaxed text-soft">
						<strong class="font-medium text-ink">A media licence has to be declared.</strong> The Merchant format has no{' '}
						column for one and <a href="/spec#licences-that-can-be-ingested" class="rounded-sm text-accent underline underline-offset-4">nothing is ingested without one</a>,{' '}
						so an import declares a single ingestible SPDX identifier covering every image and document in the file. A{' '}
						<code class="chip">license</code> column of your own overrides it row by row, and a file whose declared licence is
						not ingestible produces records without media rather than records that fail.
					</li>
				</ul>
				<p class="mt-5 text-[0.9375rem] leading-relaxed text-soft">
					A row that cannot become a record — no usable identifier, a GTIN that fails its check digit — is skipped and
					reported by spreadsheet row number, header counted as row 1, so one bad row costs that row and not the import.
					There is a worked file to check yourself against in{' '}
					<a href="/spec/fixtures/merchant" class="rounded-sm font-mono text-[0.8125rem] text-accent underline underline-offset-4">
						/spec/fixtures/merchant</a
					>: a CSV, the records it must produce, and the row that must be skipped.
				</p>
				<p class="mt-5 text-base leading-relaxed text-soft sm:text-lg">
					The part that matters for a decision made today is what happens later. Adding a TXT record on a domain you
					acquire, naming that same host, turns the slug into the domain at the next crawl —{' '}
					<strong class="font-medium text-ink">the same source, the same records, every{' '}
					<code class="chip">opid</code> kept</strong>, with trust rising from <code class="chip">unverified</code> to{' '}
					<code class="chip">verified</code>. Your <code class="chip">sku</code> identifiers are scoped to the source
					itself rather than to its name, so they survive the move. Like route 2, a hosted site is set up by an
					operator for now.
				</p>
			</div>
		</div>
	</section>

	<section aria-labelledby="trust" class="border-t border-line">
		<div class="shell py-14 sm:py-16">
			<div class="max-w-3xl">
				<h2 id="trust" class="text-2xl font-semibold tracking-tight">What trust means here</h2>
				<p class="mt-5 text-base leading-relaxed text-soft sm:text-lg">
					Trust is a property of the source, not of a claim. It says what has been proven about who is speaking, and
					nothing about whether a particular fact is correct. A consumer of the data decides what to do with that.
				</p>
				<div class="table-scroll mt-8" role="region" aria-label="Trust levels" tabindex="0">
					<table class="data-table">
						<thead>
							<tr><th scope="col">Level</th><th scope="col">Meaning</th></tr>
						</thead>
						<tbody>
							{
								trust.map((row) => (
									<tr>
										<td class="font-mono text-[0.8125rem] whitespace-nowrap">{row.level}</td>
										<td class="text-soft">{row.meaning}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</section>

	<section aria-labelledby="after" class="border-t border-line">
		<div class="shell py-14 sm:py-16">
			<div class="max-w-3xl">
				<h2 id="after" class="text-2xl font-semibold tracking-tight">After you publish</h2>
				<ul class="mt-8 grid gap-6 [&>*]:min-w-0">
					<li class="border-l-2 border-rule pl-5">
						<p class="font-medium">Changing a record is editing a line.</p>
						<p class="mt-1 text-[0.9375rem] leading-relaxed text-soft">
							Publishing a record with a key that already exists replaces the previous one. There is no update endpoint,
							because the feed is the state.
						</p>
					</li>
					<li class="border-l-2 border-rule pl-5">
						<p class="font-medium">Removing a line withdraws your claims, not the product.</p>
						<p class="mt-1 text-[0.9375rem] leading-relaxed text-soft">
							A key that disappears from a feed the crawler fetched whole marks your claims about it as withdrawn. The
							entity and its identifier stay: other people's links to it keep working, and so do the claims other sources
							made.
						</p>
					</li>
					<li class="border-l-2 border-rule pl-5">
						<p class="font-medium">Removing a feed URL from the document retires it immediately.</p>
						<p class="mt-1 text-[0.9375rem] leading-relaxed text-soft">
							When a crawl reads a document that no longer names one of your feed URLs, every live record that feed
							carried is withdrawn at once, as if all of its keys had vanished, and the URL is not fetched again. None of
							the seven-day grace below applies: dropping a URL is you saying the file is gone, and the index takes you at
							your word. Listing it again later brings it back, read from scratch. Serve the document with an{' '}
							<code class="chip">ETag</code> if you can — a <code class="chip">304</code> means the list has not changed,
							so it retires nothing.
						</p>
					</li>
					<li class="border-l-2 border-rule pl-5">
						<p class="font-medium">A broken line delays withdrawal for seven days; it does not disable it.</p>
						<p class="mt-1 text-[0.9375rem] leading-relaxed text-soft">
							A line that is over 64 KiB, unparseable or invalid is skipped and counted. Because a skipped line's key is
							unknown, a feed with skipped lines withdraws nothing — for seven days. After that, absent keys are withdrawn
							as usual. The count is public, so a feed quietly shedding lines is not quiet.
						</p>
					</li>
					<li class="border-l-2 border-rule pl-5">
						<p class="font-medium">A feed the crawler cannot read is not free.</p>
						<p class="mt-1 text-[0.9375rem] leading-relaxed text-soft">
							A crawl succeeds only when <em>everything the document lists</em> was read: an acceptable document, and every
							feed in it answering <code class="chip">200</code> or <code class="chip">304</code>. One feed timing out does
							not lose you the others — the feeds that answered are ingested, and nothing is withdrawn on a crawl that
							failed — but the crawl counts as a transport failure, and <code class="chip">feeds_failed</code> says so in
							your status. A perfectly healthy document in front of one permanently dead feed URL therefore lapses on the
							same seven-day clock as a domain that stopped answering altogether, and loses the catalogue thirty days
							after that. A feed URL you no longer serve should be removed from the document, not left to rot.
						</p>
					</li>
					<li class="border-l-2 border-rule pl-5">
						<p class="font-medium">If discovery stops succeeding, your source lapses.</p>
						<p class="mt-1 text-[0.9375rem] leading-relaxed text-soft">
							A <strong class="font-medium text-ink">definite negative</strong> — discovery ending with no acceptable
							document: no record and no document, a record that is malformed, over-long or duplicated, or a document that
							is not 200, not JSON, not valid, no longer agrees about <code class="chip">domain</code>, or lists a feed off
							its host — lapses the source at once. A <strong class="font-medium text-ink">transport failure</strong> — a
							DNS timeout, a 5xx, a 429, a cap reached, on the document or on any feed — changes nothing by itself, but
							seven consecutive days in which every attempt ends that way lapse you too, so serving errors forever is not a
							way to freeze your claims where they are.
						</p>
						<p class="mt-2 text-[0.9375rem] leading-relaxed text-soft">
							<strong class="font-medium text-ink">That benefit of the doubt belongs to a host, not to you.</strong> It
							applies only at a host your source has already been verified at. At a host it has never been verified at — a
							new slug, a host you have just re-pointed <code class="chip">_prodid</code> at, anything under routes 2 and
							3 — any failure, a timeout and a 5xx included, is a definite negative and lapses you at once. That is
							deliberate: otherwise a verified source could aim its record at a host it does not control and read back,
							from whether its lapse starts today or in a week, whether that host is up. Moving hosts costs you nothing
							for it. The first crawl that succeeds at the new host clears everything, and a lapse stays recoverable for
							the 30 days before anything is withdrawn.
						</p>
						<p class="mt-2 text-[0.9375rem] leading-relaxed text-soft">
							A lapsed source takes no new claims, is shown as lapsed to readers, and its{' '}
							<code class="chip">publisher.contact</code> is notified. A crawl of a lapsed source writes nothing until it
							has succeeded in full; only then is the lapse cleared. After 30 days of continuous lapse your{' '}
							<strong class="font-medium text-ink">records and their active claims are withdrawn together</strong>, and
							remain as history. Those 30 days are your recovery window, which is why the contact address has to be one
							somebody reads.
						</p>
						<p class="mt-2 text-[0.9375rem] leading-relaxed text-soft">
							Coming back does not require changing anything. Serve the same document and the same feed you always did and
							everything you publish is asserted again the moment discovery succeeds, whether or not a byte moved — the
							index gives up conditional requests while it holds nothing live from you, so an unchanged file is never a
							reason to stay withdrawn.
						</p>
					</li>
					<li class="border-l-2 border-rule pl-5">
						<p class="font-medium">
							<code class="chip">seen_at</code> is a continuous assertion, and a long lapse resets it.
						</p>
						<p class="mt-1 text-[0.9375rem] leading-relaxed text-soft">
							Every claim a reader sees carries <code class="chip">seen_at</code>: not when the fact was first published
							anywhere, but <em>since when this source has asserted this value without stopping</em>. It survives every
							re-crawl that finds the same value, which is the point of it. It does not survive a withdrawal. Let your
							source stay lapsed past 30 days and the date on every fact you publish restarts from the day you come back,
							because for the length of the gap nobody verifiable stood behind them. The withdrawn rows stay, so{' '}
							<code class="chip">?history=1</code> shows the gap rather than hiding it —{' '}
							<a href="/spec#an-entity" class="rounded-sm text-accent underline underline-offset-4">what a reader sees</a>{' '}
							is in the specification.
						</p>
					</li>
					<li class="border-l-2 border-rule pl-5">
						<p class="font-medium">Your source has a public status page.</p>
						<p class="mt-1 text-[0.9375rem] leading-relaxed text-soft">
							<code class="chip">/source/acme.example</code> is how you see that something is wrong: the outcome of the
							last crawl, which path discovery took, how many records changed, how many lines were skipped, how many feeds
							could not be read, and whether you are lapsed and since when. It reports only what your domain publishes and
							when the index looked — never who asked for a crawl.
						</p>
						<CodeSample
							class="mt-4"
							code={examples.source}
							lang="json"
							label="spec/examples/source.json"
							badge="application/json"
						/>
					</li>
					<li class="border-l-2 border-rule pl-5">
						<p class="font-medium">Media is sniffed, not trusted — and a bad entry costs only itself.</p>
						<p class="mt-1 text-[0.9375rem] leading-relaxed text-soft">
							The type is decided by reading the bytes; your <code class="chip">Content-Type</code> is a hint. Six types
							are stored and nothing else: JPEG, PNG, GIF, WebP and AVIF as <code class="chip">image</code>, PDF as{' '}
							<code class="chip">document</code>. No SVG, no HTML, no archives, no Office files — a spec sheet goes out as
							a PDF. The sniffed type and the entry's <code class="chip">kind</code> have to agree, or the entry is
							skipped.
						</p>
						<div class="mt-3 table-scroll" role="region" aria-label="Media caps" tabindex="0">
							<table class="data-table">
								<thead>
									<tr><th scope="col">What</th><th scope="col">Cap</th></tr>
								</thead>
								<tbody>
									{
										mediaCaps.map((row) => (
											<tr>
												<td class="whitespace-nowrap">{row.what}</td>
												<td class="font-mono text-[0.8125rem] whitespace-nowrap">{row.cap}</td>
											</tr>
										))
									}
								</tbody>
							</table>
						</div>
						<p class="mt-3 text-[0.9375rem] leading-relaxed text-soft">
							The licence is checked as a string before anything is fetched, and it must be exactly one of seven SPDX
							identifiers — the ones that let anyone redistribute the file verbatim, which is what the index does with it:
						</p>
						<CodeSample class="mt-3" code={mediaLicences} label="ingestible media licences" />
						<p class="mt-3 text-[0.9375rem] leading-relaxed text-soft">
							Everything here is per entry. An entry that is refused, too big or unreachable costs that entry and nothing
							else: <strong class="font-medium text-ink">your record is never invalid because of its media</strong>, its
							other claims stand, and no media failure lapses you. It is counted in <code class="chip">media_failed</code>{' '}
							and tried again on the next crawl of that record. One thing works the other way from feeds: the same-host
							rule does <em>not</em> apply here, so your images can live on a CDN.{' '}
							<a href="/spec#what-is-ingested" class="rounded-sm text-accent underline underline-offset-4">
								What is ingested</a
							>{' '}
							and{' '}
							<a href="/spec#licences-that-can-be-ingested" class="rounded-sm text-accent underline underline-offset-4">
								the licence list</a
							>{' '}
							have the reasoning.
						</p>
					</li>
					<li class="border-l-2 border-rule pl-5">
						<p class="font-medium">Other sources will publish about your products.</p>
						<p class="mt-1 text-[0.9375rem] leading-relaxed text-soft">
							Retailers, registries, open datasets and contributors are sources like any other. Their claims are
							attributed to them and never overwrite yours; where you disagree, both claims are visible with their
							sources side by side.
						</p>
					</li>
				</ul>
			</div>
		</div>
	</section>

	<section aria-labelledby="checklist" class="border-t border-line">
		<div class="shell py-14 sm:py-16">
			<div class="max-w-3xl">
				<h2 id="checklist" class="text-2xl font-semibold tracking-tight">Before you go live</h2>
				<ul class="mt-8 grid gap-3 [&>*]:min-w-0">
					{
						checklist.map((item) => (
							<li class="flex gap-3 text-[0.9375rem] leading-relaxed">
								<span aria-hidden="true" class="mt-[0.45em] size-1.5 shrink-0 rounded-full bg-rule" />
								<span class="text-soft">{item}</span>
							</li>
						))
					}
				</ul>
				<p class="mt-8 text-[0.9375rem] leading-relaxed text-soft">
					The rules a record is validated against are in the{' '}
					<a href="/spec" class="rounded-sm text-accent underline underline-offset-4">specification</a>, the schemas are
					served at{' '}
					<a href="/spec/schemas" class="rounded-sm font-mono text-[0.8125rem] text-accent underline underline-offset-4">
						/spec/schemas</a
					>, and{' '}
					<a href="/spec/fixtures" class="rounded-sm font-mono text-[0.8125rem] text-accent underline underline-offset-4">
						/spec/fixtures</a
					>{' '}
					holds machine-readable vectors you can run your exporter against before anyone crawls it.
				</p>
				<p class="mt-6 rounded-lg border border-line bg-surface p-5 text-[0.9375rem] leading-relaxed text-soft">
					<strong class="font-medium text-ink">Status:</strong> the specification is a v0 draft and the index is not
					running yet, so nothing published today is crawled today. The file formats on this page are what will be read
					when it is, and they are worth generating now.
				</p>
			</div>
		</div>
	</section>
</Layout>
