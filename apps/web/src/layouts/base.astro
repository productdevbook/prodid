---
import SiteFooter from '@/components/site-footer.astro'
import SiteHeader from '@/components/site-header.astro'
import '@/styles/global.css'

interface Props {
	title: string
	description: string
	active?: 'spec' | 'publish' | 'data' | undefined
	noindex?: boolean | undefined
	notFound?: boolean | undefined
}

const { title, description, active, noindex = false, notFound = false } = Astro.props

const path = Astro.url.pathname.replace(/\/+$/, '') || '/'
const canonical = new URL(path, Astro.site).href
const image = new URL('/og.png', Astro.site).href
const IMAGE_ALT =
	'prodid: publishers state product facts on their own domains, one open index joins every code to a permanent identifier, and anyone can download the whole index.'
const site = new URL('/', Astro.site).href
const structured = JSON.stringify({
	'@context': 'https://schema.org',
	'@graph': [
		{ '@type': 'WebSite', '@id': `${site}#website`, url: site, name: 'prodid', description, publisher: { '@id': `${site}#organization` } },
		{
			'@type': 'Organization',
			'@id': `${site}#organization`,
			name: 'prodid',
			url: site,
			logo: new URL('/apple-touch-icon.png', Astro.site).href,
			sameAs: ['https://github.com/productdevbook/prodid', 'https://www.npmjs.com/package/prodid'],
		},
	],
})
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="prodid" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content="en" />
		<meta property="og:image" content={image} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={IMAGE_ALT} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta name="twitter:image:alt" content={IMAGE_ALT} />
		<script type="application/ld+json" is:inline set:html={structured} />

		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f9f8f5" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#14161b" />
		<script is:inline>
			// Before first paint, so a stored choice never flashes the other theme.
			try {
				const theme = localStorage.getItem('theme')
				if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme
			} catch {}
		</script>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="alternate" type="application/xml" href="/sitemap.xml" title="Sitemap" />
	</head>
	<body class="flex min-h-svh flex-col" data-not-found={notFound || undefined}>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:border focus:border-line focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:font-medium"
		>
			Skip to content
		</a>
		<SiteHeader active={active} />
		<main id="main" tabindex="-1" class="flex-1">
			<slot />
		</main>
		<SiteFooter />
		<script>
			import { createAnalytics } from 'useyuva/analytics'

			const analytics = createAnalytics({ server: 'https://app.useyuva.com', key: 'yuva_ak_qsOqNT6-hgJHzXppLQwkCUxK' })
			if (document.body.dataset.notFound !== undefined) analytics.notFound()
		</script>
	</body>
</html>
