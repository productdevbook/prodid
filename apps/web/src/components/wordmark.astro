---
interface Props {
	class?: string | undefined
}

const { class: className } = Astro.props
---

<span class:list={['inline-flex items-baseline gap-2 font-mono font-semibold tracking-tight lowercase', className]}>
	<svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true" class="size-[0.95em] shrink-0 translate-y-[0.06em]">
		<rect x="3" y="6" width="2.6" height="20" rx="1.3"></rect>
		<rect x="8.6" y="9" width="1.5" height="14" rx="0.75"></rect>
		<rect x="13.1" y="6" width="3.2" height="20" rx="1.6"></rect>
		<circle cx="24.6" cy="16" r="4.6"></circle>
	</svg>
	<span>prodid</span>
</span>
