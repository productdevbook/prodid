---
interface Props {
	eyebrow?: string | undefined
	title: string
	lead?: string | undefined
}

const { eyebrow, title, lead } = Astro.props
---

<div class="shell">
	<div class="max-w-3xl pt-12 pb-10 sm:pt-16 sm:pb-14">
		{eyebrow && <p class="mb-4 font-mono text-xs tracking-[0.18em] text-soft uppercase">{eyebrow}</p>}
		<h1 class="text-3xl leading-[1.15] font-semibold tracking-tight sm:text-[2.6rem]">{title}</h1>
		{lead && <p class="mt-5 text-lg leading-relaxed text-soft">{lead}</p>}
		<slot />
	</div>
</div>
