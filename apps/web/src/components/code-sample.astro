---
import { Code } from 'astro:components'
import type { ComponentProps } from 'astro/types'
import { Badge } from '@/components/ui/badge'
import { SHIKI_THEMES } from '@/lib/shiki'

interface Props {
	code: string
	lang?: ComponentProps<typeof Code>['lang'] | undefined
	label?: string | undefined
	badge?: string | undefined
	caption?: string | undefined
	/** Caps a long sample so it does not swallow the page; the block scrolls and stays keyboard reachable. */
	scroll?: boolean | undefined
	class?: string | undefined
}

const { code, lang = 'plaintext', label, badge, caption, scroll = false, class: className } = Astro.props
---

<figure class:list={['not-prose w-full min-w-0', className]}>
	<div class="relative overflow-hidden rounded-xl bg-card text-card-foreground ring-1 ring-foreground/10">
		{
			label && (
				<div class="flex min-h-10 items-center justify-between gap-4 border-b bg-muted py-1 ps-4 pe-2">
					<span class="truncate font-mono text-xs text-soft">{label}</span>
					<span class="flex shrink-0 items-center gap-2">
						{badge && <Badge variant="outline" className="font-mono text-[0.65rem] tracking-wider uppercase">{badge}</Badge>}
						<span data-copy-slot class="flex min-w-14 justify-end" />
					</span>
				</div>
			)
		}
		{!label && <span data-copy-slot class="absolute end-2 top-2 z-10" />}
		<Code
			code={code}
			lang={lang}
			themes={SHIKI_THEMES}
			defaultColor={false}
			class:list={['overflow-auto overscroll-contain p-4 text-[0.8125rem] leading-relaxed', scroll && 'max-h-[34rem]']}
		/>
	</div>
	{caption && <figcaption class="mt-2.5 text-sm leading-relaxed text-soft">{caption}</figcaption>}
</figure>
