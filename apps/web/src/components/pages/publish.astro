---
import CodeSample from '@/components/code-sample.astro'
import { DataTable } from '@/components/data-table'
import { AccordionList } from '@/components/accordion-list'
import { Checklist } from '@/components/checklist'
import { CopyButtons } from '@/components/copy-buttons'
import { Disclosure } from '@/components/disclosure'
import { DomainCheck } from '@/components/domain-check'
import { FieldList } from '@/components/field-list'
import PageHeader from '@/components/page-header.astro'
import PublishStep from '@/components/publish-step.astro'
import { RouteChoice } from '@/components/route-choice'
import { RouteProgress } from '@/components/route-progress'
import { buttonVariants } from '@/components/ui/button'
import { copyFor } from '@/i18n'
import { type LocaleCode, localeOf } from '@/i18n/locales'
import { rich } from '@/i18n/rich'
import Layout from '@/layouts/base.astro'
import { examples, HOSTED_PUBLISHER } from '@/lib/spec'

interface Props {
	code: LocaleCode
}

const { code } = Astro.props
const { dir } = localeOf(code)
const all = copyFor(code)
const copy = all.publish
const r = (text: string) => rich(text, code)

const routes = (
	[
		{ n: '1', id: 'own', trust: 'verified', href: '#own-domain', hosted: false },
		{ n: '2', id: 'delegated', trust: 'verified', href: '#delegated', hosted: true },
		{ n: '3', id: 'hosted', trust: 'unverified', href: '#hosted', hosted: true },
	] as const
).map((route, index) => ({ ...route, ...copy.routes.items[index]! }))

const required = { yes: copy.table.yes, no: copy.table.no, delegating: copy.table.delegating }

const feedFields = (
	[
		['$type', 'yes'],
		['version', 'yes'],
		['publisher.name', 'yes'],
		['publisher.contact', 'no'],
		['license', 'yes'],
		['feeds', 'yes'],
		['domain', 'delegating'],
	] as const
).map(([field, need], index) => ({ field, need, required: required[need], note: copy.own.feedFields[index] ?? '' }))

const itemFields = (
	[
		['$type', 'yes'],
		['key', 'yes'],
		['brand', 'yes'],
		['name', 'yes'],
		['identifiers', 'yes'],
		['lang', 'no'],
		['group', 'no'],
		['variant', 'no'],
		['category', 'no'],
		['markets', 'no'],
		['properties', 'no'],
		['media', 'no'],
	] as const
).map(([field, need], index) => ({ field, need, required: required[need], note: copy.own.itemFields[index] ?? '' }))

const trust = ['authoritative', 'verified', 'unverified'].map((level, index) => ({
	cells: [{ text: level, className: 'font-mono text-[0.8125rem] whitespace-nowrap' }, { text: copy.trust.levels[index] ?? '', className: 'text-muted-foreground' }],
}))

const txtRecord = `_prodid.acme.example. IN TXT "v=prodid0; host=acme.example"`

const txtDelegated = `_prodid.acme.example. IN TXT "v=prodid0; host=acme.prodid.org"`

const ping = `curl -X POST https://prodid.org/ping \\
  -H 'content-type: application/json' \\
  -d '{"domain": "acme.example"}'

HTTP/1.1 202 Accepted
Content-Type: application/json

{"status":"accepted"}`

const wellKnown = 'https://acme.example/.well-known/prodid.json'

const checkFiles = `git clone https://github.com/productdevbook/prodid
cd prodid
bun install --frozen-lockfile
curl -fsSo prodid.json https://acme.example/.well-known/prodid.json
curl -fsSo items.ndjson https://acme.example/prodid/items.ndjson
bun apps/batch/src/cli.ts check prodid.json items.ndjson

prodid.json: ok, 1 record
items.ndjson: ok, 3 records`

const mediaCaps = ['20 MiB', '50 MiB', '60 s', '20'].map((cap, index) => ({
	cells: [{ text: copy.after.media.caps[index] ?? '', className: 'whitespace-nowrap' }, { text: cap, className: 'font-mono text-[0.8125rem] whitespace-nowrap' }],
}))

const mediaLicences = `CC0-1.0  CC-BY-4.0  CC-BY-SA-4.0  CC-BY-ND-4.0
CC-BY-3.0  CC-BY-SA-3.0  CC-BY-ND-3.0`

const stepTitle = (text: string) => (text.includes(' — ') ? text.split(' — ').slice(1).join(' — ') : text)

const delegatedSteps = copy.delegated.steps.map((text) => {
	const match = /^\*\*(.+?)\*\*[\s—–-]*([\s\S]*)$/.exec(text)
	return { title: r(match?.[1] ?? text), lead: match?.[2] ? r(match[2]) : undefined }
})

const after = copy.after
const paragraphs = (texts: readonly string[]) => texts.map((text) => `<p>${r(text)}</p>`).join('')
const afterItems = [
	...[after.edit, after.remove, after.retire, after.broken, after.unreadable].map((entry) => ({ title: r(entry.title), html: paragraphs([entry.body]) })),
	{ title: r(after.lapse.title), html: paragraphs(after.lapse.body) },
	{ title: r(after.seen.title), html: paragraphs([after.seen.body]) },
	{ title: r(after.status.title), slot: 'first' as const },
	{ title: r(after.media.title), slot: 'second' as const },
	{ title: r(after.others.title), html: paragraphs([after.others.body]) },
]
const note = 'border-s-2 border-rule ps-4 text-[0.9375rem] leading-relaxed text-soft'
const body = 'text-[0.9375rem] leading-relaxed text-soft'
const panel = 'route-panel'
const eyebrow = 'font-mono text-xs tracking-[0.18em] text-soft uppercase'
---

<Layout title={copy.title} description={copy.description} active="publish" code={code} page="publish">
	<PageHeader eyebrow={copy.eyebrow} title={copy.heading} lead={copy.lead} />

	<div class="border-t">
		<div class="shell py-12 sm:py-16">
			<div class="route-switch mx-auto max-w-[45rem]" data-route="own">
				<section aria-labelledby="routes">
					<h2 id="routes" class="text-2xl font-semibold tracking-tight sm:text-3xl">{copy.question}</h2>
					<RouteChoice
						client:visible
						routes={routes.map((route) => ({ id: route.id, eyebrow: copy.routes.route(route.n), when: route.when, who: route.who }))}
						labelledby="routes"
						dir={dir}
					/>

					<Disclosure client:visible className="mt-4 shadow-none">
						<Fragment slot="title">{copy.routes.heading}</Fragment>
						<p class={body}>{copy.routes.lead}</p>
						<ol class="mt-5 grid gap-6 [&>*]:min-w-0">
							{
								routes.map((route) => (
									<li class="border-t pt-5 first:border-t-0 first:pt-0">
										<p class={eyebrow}>{copy.routes.route(route.n)}</p>
										<p class="mt-2 text-base font-semibold tracking-tight">{route.when}</p>
										<p class={`mt-2 ${body}`}>{route.how}</p>
										<dl class="mt-3 grid gap-1.5 text-[0.8125rem]">
											<div class="flex gap-2">
												<dt class="w-16 shrink-0 text-soft">{copy.routes.identity}</dt>
												<dd>{route.identity}</dd>
											</div>
											<div class="flex gap-2">
												<dt class="w-16 shrink-0 text-soft">{copy.routes.trust}</dt>
												<dd class="font-mono">{route.trust}</dd>
											</div>
										</dl>
										<div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium">
											<a href={route.href} class="rounded-sm text-brand underline-offset-4 hover:underline">
												{copy.routes.detail(route.n)}
											</a>
											{route.hosted && (
												<a href={HOSTED_PUBLISHER} class={buttonVariants({ variant: 'outline', size: 'sm' })}>
													{copy.routes.start}
												</a>
											)}
										</div>
									</li>
								))
							}
						</ol>
						<p class={`mt-6 ${body}`} set:html={r(copy.routes.hosted)} />
					</Disclosure>
				</section>

				<div class="mt-14 sm:mt-16">
					<section aria-labelledby="own-domain" class={panel} data-route-panel="own">
						<p class={eyebrow}>{copy.own.eyebrow}</p>
						<h2 id="own-domain" class="mt-3 text-2xl font-semibold tracking-tight">{copy.own.heading}</h2>
						<p class="mt-3 text-base leading-relaxed text-soft">{copy.own.lead}</p>

						<RouteProgress client:visible total={4} label={copy.progress} className="mt-8" />

						<ol class="mt-8">
							<PublishStep done={copy.done} n="1" title={r(stepTitle(copy.own.step1))} lead={r(copy.own.step1Lead(wellKnown))} details={copy.details}>
								<CodeSample code={examples.feed} lang="json" label=".well-known/prodid.json" badge="application/json" caption={copy.own.feedCaption} />
								<Fragment slot="details">
									<FieldList label={copy.own.feedTable} tag={copy.table.required} fields={feedFields} />
									<p class={body} set:html={r(copy.own.serve)} />
								</Fragment>
							</PublishStep>

							<PublishStep done={copy.done} n="2" title={r(stepTitle(copy.own.step2))} lead={r(copy.own.step2Lead)} details={copy.details}>
								<CodeSample code={examples.items} lang="jsonl" label="prodid/items.ndjson" badge="application/x-ndjson" caption={copy.own.itemsCaption} />
								<Fragment slot="details">
									<p class={note} set:html={r(copy.own.sameHost)} />
									<p class={body}>{copy.own.firstLine}</p>
									<CodeSample code={examples.itemJacket} lang="json" label={copy.own.itemLabel} />
									<FieldList label={copy.own.itemTable} tag={copy.table.required} fields={itemFields} />
									<p class={body} set:html={r(copy.own.flat)} />
									<p class={body} set:html={r(copy.own.barcodes)} />
								</Fragment>
							</PublishStep>

							<PublishStep done={copy.done} n="3" title={r(stepTitle(copy.own.step3))} lead={r(copy.own.step3Lead)} details={copy.details}>
								<CodeSample code={txtRecord} lang="ini" label="_prodid.acme.example TXT" />
								<Fragment slot="details">
									<p class={body} set:html={r(copy.own.step3Why)} />
									<p class={note} set:html={r(copy.own.neverDelegate)} />
									<p class={body} set:html={r(copy.own.order)} />
								</Fragment>
							</PublishStep>

							<PublishStep done={copy.done} n="4" title={r(stepTitle(copy.own.step4))} lead={r(copy.own.step4Lead)} details={copy.details}>
								<CodeSample code={ping} lang="bash" label={copy.own.pingLabel} />
								<Fragment slot="details">
									<p class={body} set:html={r(copy.own.ping)} />
								</Fragment>
							</PublishStep>
						</ol>
					</section>

					<section aria-labelledby="delegated" class={panel} data-route-panel="delegated">
						<p class={eyebrow}>{copy.delegated.eyebrow}</p>
						<h2 id="delegated" class="mt-3 text-2xl font-semibold tracking-tight">{copy.delegated.heading}</h2>
						<p class="mt-3 text-base leading-relaxed text-soft" set:html={r(copy.delegated.lead)} />
						<p class={`mt-8 ${eyebrow}`}>{copy.delegated.looks}</p>

						<RouteProgress client:visible total={4} label={copy.progress} className="mt-6" />

						<ol class="mt-6">
							<PublishStep done={copy.done} n="1" title={delegatedSteps[0]?.title ?? ''} lead={delegatedSteps[0]?.lead} />
							<PublishStep done={copy.done} n="2" title={delegatedSteps[1]?.title ?? ''} lead={delegatedSteps[1]?.lead}>
								<CodeSample code={txtDelegated} lang="ini" label="_prodid.acme.example TXT" />
							</PublishStep>
							<PublishStep done={copy.done} n="3" title={delegatedSteps[2]?.title ?? ''} lead={delegatedSteps[2]?.lead}>
								<CodeSample
									code={examples.feedDelegated}
									lang="json"
									label="acme.prodid.org/.well-known/prodid.json"
									badge="application/json"
									caption={copy.delegated.caption}
								/>
							</PublishStep>
							<PublishStep done={copy.done} n="4" title={copy.go} lead={r(copy.delegated.window)}>
								<div>
									<a href={HOSTED_PUBLISHER} class={buttonVariants({ size: 'lg' })}>{copy.routes.start}</a>
								</div>
							</PublishStep>
						</ol>
					</section>

					<section aria-labelledby="hosted" class={panel} data-route-panel="hosted">
						<p class={eyebrow}>{copy.hosted.eyebrow}</p>
						<h2 id="hosted" class="mt-3 text-2xl font-semibold tracking-tight">{copy.hosted.heading}</h2>

						<RouteProgress client:visible total={1} label={copy.progress} className="mt-8" />

						<ol class="mt-8">
							<PublishStep done={copy.done} n="1" title={copy.go} lead={r(copy.hosted.lead)} details={copy.details}>
								<div>
									<a href={HOSTED_PUBLISHER} class={buttonVariants({ size: 'lg' })}>{copy.routes.start}</a>
								</div>
								<Fragment slot="details">
									<p class={body} set:html={r(copy.hosted.merchant)} />
									<ul class="grid gap-4 [&>*]:min-w-0">
										{copy.hosted.rules.map((rule) => <li class={note} set:html={r(rule)} />)}
									</ul>
									<p class={body} set:html={r(copy.hosted.skipped)} />
									<p class={body} set:html={r(copy.hosted.later)} />
								</Fragment>
							</PublishStep>
						</ol>
					</section>

					<div class="relative ps-14">
						<span aria-hidden="true" class="absolute start-0 top-0 grid size-9 place-items-center rounded-full border-2 border-brand bg-bg font-mono text-sm text-brand">&#10003;</span>
						<h2 id="check" class="pt-1 text-lg leading-snug font-semibold tracking-tight">{copy.check.heading}</h2>
						<p class={`mt-2 ${body}`}>{copy.check.lead}</p>
						<div class="mt-5 rounded-xl bg-card p-5 text-card-foreground ring-1 ring-foreground/10">
							<DomainCheck
								client:visible
								label={copy.check.label}
								placeholder={copy.check.placeholder}
								button={copy.check.button}
								working={copy.check.working}
								invalid={copy.check.invalid}
								limited={copy.check.limited}
								failed={copy.check.failed}
								note={copy.check.note}
							/>
						</div>
						<noscript>
							<p class={`mt-3 ${body}`}>
								{copy.check.noscript} <code class="chip">https://prodid.org/source/&lt;{copy.check.placeholder}&gt;</code>
							</p>
						</noscript>
						<Disclosure client:visible className="mt-6 shadow-none">
							<Fragment slot="title">{copy.check.looks}</Fragment>
							<h2 id="checklist" class="text-base font-semibold tracking-tight">{copy.checklist.heading}</h2>
							<div class="mt-4">
								<Checklist client:visible items={copy.checklist.items} />
							</div>
						</Disclosure>
						<h3 class="mt-10 text-base font-semibold tracking-tight">{copy.checklist.check}</h3>
						<p class={`mt-3 ${body}`} set:html={r(copy.checklist.checkLead)} />
						<CodeSample class="mt-5" code={checkFiles} lang="bash" label={copy.checklist.checkLabel} />
						<p class={`mt-4 ${body}`} set:html={r(copy.checklist.checkResult)} />
						<p class={`mt-6 ${body}`} set:html={r(copy.checklist.rules)} />
						{code !== 'en' && <p class={`mt-4 ${body}`}>{all.common.normative}</p>}
						<p class={`mt-6 ${note}`}>
							<strong class="font-medium text-ink">{copy.checklist.status}</strong>{' '}
							{`${all.common.status} ${copy.checklist.formats}`}
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>

	<section aria-labelledby="reference" class="border-t bg-muted/40">
		<div class="shell py-14 sm:py-16">
			<h2 id="reference" class="text-2xl font-semibold tracking-tight">{copy.reference}</h2>
			<div class="mt-8 grid items-start gap-4 md:grid-cols-2 [&>*]:min-w-0">
				<Disclosure client:visible id="discovery">
					<Fragment slot="title">{copy.discovery.heading}</Fragment>
					<div class="grid gap-5 [&>*]:min-w-0">
						<p class={body}>{copy.discovery.lead}</p>
						<ol class="grid gap-5">
							<li class={note}>
								<p class={eyebrow}>{copy.discovery.first}</p>
								<p class="mt-2 font-medium text-ink" set:html={r(copy.discovery.firstTitle)} />
								<p class="mt-2" set:html={r(copy.discovery.firstBody)} />
							</li>
							<li class={note}>
								<p class={eyebrow}>{copy.discovery.second}</p>
								<p class="mt-2 font-medium text-ink"><code class="chip">{wellKnown}</code></p>
								<p class="mt-2">{copy.discovery.secondBody}</p>
							</li>
						</ol>
						<p class={body} set:html={r(copy.discovery.why)} />
						<p class={note} set:html={r(copy.discovery.one)} />
						<p class={note} set:html={r(copy.discovery.answer)} />
					</div>
				</Disclosure>

				<Disclosure client:visible id="trust">
					<Fragment slot="title">{copy.trust.heading}</Fragment>
					<div class="grid gap-5 [&>*]:min-w-0">
						<p class={body}>{copy.trust.lead}</p>
						<DataTable label={copy.trust.table} columns={[copy.trust.level, copy.trust.meaning]} rows={trust} />
						<p class={body} set:html={r(copy.trust.only)} />
						<ul class="grid gap-5 [&>*]:min-w-0">
							{
								copy.trust.rules.map((rule) => (
									<li class={note}>
										<p class="font-medium text-ink">{rule.title}</p>
										<p class="mt-1" set:html={r(rule.body)} />
									</li>
								))
							}
						</ul>
						<p class={body} set:html={r(copy.trust.ask)} />
					</div>
				</Disclosure>

				<Disclosure client:visible id="after" className="md:col-span-2">
					<Fragment slot="title">{after.heading}</Fragment>
					<AccordionList client:visible items={afterItems} dir={dir}>
						<Fragment slot="first">
							<p set:html={r(after.status.body)} />
							<CodeSample class="mt-4" code={examples.source} lang="json" label="spec/fixtures/v1/examples/source.json" badge="application/json" />
						</Fragment>
						<Fragment slot="second">
							<p set:html={r(after.media.sniffed)} />
							<DataTable className="mt-3" label={after.media.table} columns={[after.media.what, after.media.cap]} rows={mediaCaps} minWidth="min-w-0" />
							<p class="mt-3">{after.media.licence}</p>
							<CodeSample class="mt-3" code={mediaLicences} label={after.media.licences} />
							<p class="mt-3" set:html={r(after.media.entry)} />
						</Fragment>
					</AccordionList>
				</Disclosure>
			</div>
		</div>
	</section>
	<CopyButtons client:idle copy={copy.own.copy} copied={copy.own.copied} />
</Layout>

<script>
	const flow = document.querySelector<HTMLElement>('.route-switch')

	function reveal() {
		const id = decodeURIComponent(location.hash.slice(1))
		const target = id ? document.getElementById(id) : null
		if (!target) return
		const route = target.closest<HTMLElement>('[data-route-panel]')?.dataset.routePanel
		if (route && flow) {
			flow.dataset.route = route
			dispatchEvent(new Event('routechange'))
		}
		target.scrollIntoView()
	}

	if (flow) {
		flow.dataset.js = ''
		reveal()
		addEventListener('hashchange', reveal)
	}
</script>
