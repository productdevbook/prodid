---
import { ChevronDown } from 'lucide-react'

interface Props {
	open?: boolean | undefined
	class?: string | undefined
	summaryClass?: string | undefined
}

const { open = false, class: className, summaryClass } = Astro.props
---

<details class:list={['group rounded-xl bg-card text-card-foreground shadow-xs ring-1 ring-foreground/10', className]} open={open}>
	<summary
		class:list={[
			'flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 px-5 py-3 text-start text-sm font-medium [&::-webkit-details-marker]:hidden',
			summaryClass,
		]}
	>
		<span><slot name="title" /></span>
		<ChevronDown className="size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" />
	</summary>
	<div class="border-t px-5 py-4">
		<slot />
	</div>
</details>
