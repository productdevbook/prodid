---
import Wordmark from '@/components/wordmark.astro'
import { copyFor } from '@/i18n'
import { LOCALES, type LocaleCode, localeOf, type PageKey, pagePath } from '@/i18n/locales'

interface Props {
	active?: 'spec' | 'publish' | 'data' | undefined
	code: LocaleCode
	page?: PageKey | undefined
}

const { active, code, page } = Astro.props
const copy = copyFor(code).common
const current = localeOf(code)

const links = [
	{ key: 'spec', href: '/spec', label: copy.nav.spec, short: copy.nav.specShort },
	{ key: 'publish', href: pagePath(code, 'publish'), label: copy.nav.publish, short: copy.nav.publishShort },
	{ key: 'data', href: pagePath(code, 'data'), label: copy.nav.data, short: copy.nav.dataShort },
] as const

const languages = LOCALES.map((entry) => ({ ...entry, href: pagePath(entry.code, page ?? 'home') }))

const REPOSITORY = 'https://github.com/productdevbook/prodid'
---

<header class="sticky top-0 z-40 border-b border-line bg-bg">
	<div class="shell flex h-14 items-center justify-between gap-4 sm:gap-6">
		<a href={pagePath(code, 'home')} class="shrink-0 rounded-sm text-[0.95rem] hover:text-accent" aria-label={copy.home}>
			<Wordmark />
		</a>
		<nav aria-label={copy.primary} class="flex min-w-0 items-center gap-3 sm:gap-6">
			<ul class="flex min-w-0 items-center gap-3 text-sm sm:gap-6">
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								aria-current={active === link.key ? 'page' : undefined}
								class:list={[
									'rounded-sm whitespace-nowrap underline-offset-4 hover:text-accent hover:underline',
									active === link.key ? 'font-medium text-accent' : 'text-soft',
								]}
							>
								{link.short === link.label ? (
									link.label
								) : (
									<>
										<span class="sm:hidden">{link.short}</span>
										<span class="hidden sm:inline">{link.label}</span>
									</>
								)}
							</a>
						</li>
					))
				}
			</ul>
			<div class="-me-2 flex shrink-0 items-center">
				<details class="relative" data-language-menu>
					<summary
						class="flex h-10 cursor-pointer list-none items-center gap-1 rounded-md px-2 font-mono text-xs text-soft hover:bg-sunken hover:text-ink [&::-webkit-details-marker]:hidden"
					>
						<svg viewBox="0 0 24 24" class="size-[1.05rem]" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
							<circle cx="12" cy="12" r="9"></circle>
							<path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"></path>
						</svg>
						<span class="sr-only">{copy.language}:</span>
						<span class="uppercase">{current.code}</span>
					</summary>
					<ul
						class="absolute end-0 top-full z-50 mt-2 grid w-44 gap-px rounded-lg border border-line bg-surface p-1 text-sm shadow-[0_8px_24px_-12px_rgb(0_0_0/0.25)]"
					>
						{
							languages.map((entry) => (
								<li>
									<a
										href={entry.href}
										lang={entry.hreflang}
										hreflang={entry.hreflang}
										dir={entry.dir}
										aria-current={entry.code === code ? 'true' : undefined}
										class:list={[
											'block rounded-md px-3 py-2 hover:bg-sunken',
											entry.code === code ? 'font-medium text-accent' : 'text-ink',
										]}
									>
										{entry.name}
									</a>
								</li>
							))
						}
					</ul>
				</details>
				<a
					href={REPOSITORY}
					aria-label={copy.github}
					class="hidden size-10 place-items-center rounded-md text-soft hover:bg-sunken hover:text-ink sm:grid"
				>
					<svg viewBox="0 0 24 24" class="size-[1.15rem]" fill="currentColor" aria-hidden="true">
						<path
							d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
						></path>
					</svg>
				</a>
				<button
					type="button"
					data-theme-toggle
					data-to-dark={copy.toDark}
					data-to-light={copy.toLight}
					aria-label={copy.toDark}
					class="grid size-10 place-items-center rounded-md text-soft hover:bg-sunken hover:text-ink"
				>
					<svg viewBox="0 0 24 24" class="theme-icon-moon size-[1.15rem]" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
						<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" stroke-linejoin="round"></path>
					</svg>
					<svg viewBox="0 0 24 24" class="theme-icon-sun size-[1.15rem]" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
						<circle cx="12" cy="12" r="4"></circle>
						<path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
					</svg>
				</button>
			</div>
		</nav>
	</div>
</header>

<script>
	const media = window.matchMedia('(prefers-color-scheme: dark)')
	const current = (): 'light' | 'dark' => {
		const chosen = document.documentElement.dataset.theme
		if (chosen === 'light' || chosen === 'dark') return chosen
		return media.matches ? 'dark' : 'light'
	}
	const label = (): void => {
		const toDark = current() !== 'dark'
		for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
			const text = toDark ? button.dataset.toDark : button.dataset.toLight
			if (text !== undefined) button.setAttribute('aria-label', text)
		}
	}
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
		button.addEventListener('click', () => {
			const next = current() === 'dark' ? 'light' : 'dark'
			document.documentElement.dataset.theme = next
			try {
				localStorage.setItem('theme', next)
			} catch {}
			label()
		})
	}
	media.addEventListener('change', label)
	label()

	const menu = document.querySelector<HTMLDetailsElement>('[data-language-menu]')
	document.addEventListener('click', (event) => {
		if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false
	})
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && menu?.open) {
			menu.open = false
			menu.querySelector('summary')?.focus()
		}
	})
</script>
