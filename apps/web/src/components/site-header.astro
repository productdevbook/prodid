---
import GithubMark from '@/components/github-mark.astro'
import StarMark from '@/components/star-mark.astro'
import Wordmark from '@/components/wordmark.astro'
import { Button, buttonVariants } from '@/components/ui/button'
import { copyFor } from '@/i18n'
import { LOCALES, type LocaleCode, localeOf, type PageKey, pagePath } from '@/i18n/locales'
import { formatStars, REPOSITORY } from '@/lib/github'
import { cn } from '@/lib/utils'
import { ArrowRight, Globe, Menu, Moon, Sun, X } from 'lucide-react'

interface Props {
	active?: 'spec' | 'publish' | 'data' | undefined
	code: LocaleCode
	page?: PageKey | undefined
	stars?: number | undefined
}

const { active, code, page, stars } = Astro.props
const copy = copyFor(code).common
const current = localeOf(code)
const starCount = stars === undefined ? undefined : formatStars(stars, current.hreflang)
const starLabel = starCount === undefined ? copy.support.star : `${copy.support.star}, ${copy.support.stars(starCount)}`

const links = [
	{ key: 'spec', href: '/spec', label: copy.nav.spec },
	{ key: 'publish', href: pagePath(code, 'publish'), label: copy.nav.publish },
	{ key: 'data', href: pagePath(code, 'data'), label: copy.nav.data },
] as const

const languages = LOCALES.map((entry) => ({ ...entry, href: pagePath(entry.code, page ?? 'home') }))
---

<header class="sticky top-0 z-40 border-b bg-background">
	<div class="shell flex h-14 items-center justify-between gap-4 sm:gap-6">
		<a href={pagePath(code, 'home')} class="shrink-0 rounded-sm text-[0.95rem] hover:text-brand" aria-label={copy.home}>
			<Wordmark />
		</a>
		<nav aria-label={copy.primary} class="flex min-w-0 items-center gap-3 sm:gap-4">
			<ul class="hidden items-center gap-1 sm:flex">
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								aria-current={active === link.key ? 'page' : undefined}
								class={cn(buttonVariants({ variant: 'ghost' }), 'whitespace-nowrap', active === link.key ? 'text-brand' : 'text-muted-foreground')}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
			<div class="-me-2 flex shrink-0 items-center gap-1">
				<details class="group sm:hidden" data-menu>
					<summary class={cn(buttonVariants({ variant: 'ghost', size: 'icon-lg' }), 'list-none [&::-webkit-details-marker]:hidden')}>
						<span class="sr-only">{copy.nav.menu}</span>
						<Menu className="size-5 group-open:hidden" />
						<X className="hidden size-5 group-open:block" />
					</summary>
					<div class="absolute inset-x-0 top-full border-b bg-popover text-popover-foreground shadow-md">
						<ul class="shell grid py-2">
							{
								links.map((link) => (
									<li class="border-b">
										<a
											href={link.href}
											aria-current={active === link.key ? 'page' : undefined}
											class={cn(
												buttonVariants({ variant: 'ghost', size: 'lg' }),
												'h-12 w-full justify-between text-base',
												active === link.key && 'text-brand',
											)}
										>
											{link.label}
											<ArrowRight className="size-4 text-muted-foreground rtl:rotate-180" />
										</a>
									</li>
								))
							}
							<li>
								<a href={REPOSITORY} aria-label={starLabel} class={cn(buttonVariants({ variant: 'ghost', size: 'lg' }), 'h-12 w-full justify-start gap-2 text-base')}>
									<GithubMark class="size-4 shrink-0" />
									<StarMark class="size-4 shrink-0 text-muted-foreground" />
									<span>{copy.support.star}</span>
									{starCount !== undefined && <span class="ms-auto font-mono text-xs text-muted-foreground">{starCount}</span>}
								</a>
							</li>
						</ul>
					</div>
				</details>
				<details class="relative" data-menu>
					<summary
						class={cn(buttonVariants({ variant: 'ghost', size: 'lg' }), 'list-none gap-1 px-2 font-mono text-xs text-muted-foreground [&::-webkit-details-marker]:hidden')}
					>
						<Globe className="size-[1.05rem]" />
						<span class="sr-only">{copy.language}:</span>
						<span class="hidden uppercase sm:inline">{current.code}</span>
						<span class="sr-only sm:hidden">{current.name}</span>
					</summary>
					<ul class="absolute end-0 top-full z-50 mt-2 grid w-52 gap-px rounded-lg bg-popover p-1 text-sm text-popover-foreground shadow-md ring-1 ring-foreground/10">
						{
							languages.map((entry) => (
								<li>
									<a
										href={entry.href}
										lang={entry.hreflang}
										hreflang={entry.hreflang}
										dir={entry.dir}
										aria-current={entry.code === code ? 'true' : undefined}
										class={cn(
											buttonVariants({ variant: 'ghost' }),
											'w-full justify-start px-3',
											entry.code === code && 'bg-muted text-brand',
										)}
									>
										{entry.name}
									</a>
								</li>
							))
						}
					</ul>
				</details>
				<a
					href={REPOSITORY}
					aria-label={starLabel}
					class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'me-1 hidden gap-1.5 text-xs text-muted-foreground sm:inline-flex')}
				>
					<GithubMark class="size-4 shrink-0" />
					<StarMark class="size-4 shrink-0" />
					<span class="hidden whitespace-nowrap lg:inline">{copy.support.star}</span>
					{starCount !== undefined && <span class="border-s ps-1.5 font-mono">{starCount}</span>}
				</a>
				<Button
					variant="ghost"
					size="icon-lg"
					data-theme-toggle
					data-to-dark={copy.toDark}
					data-to-light={copy.toLight}
					aria-label={copy.toDark}
					className="text-muted-foreground"
				>
					<Moon className="theme-icon-moon size-5" />
					<Sun className="theme-icon-sun size-5" />
				</Button>
			</div>
		</nav>
	</div>
</header>

<script>
	const media = window.matchMedia('(prefers-color-scheme: dark)')
	const current = (): 'light' | 'dark' => {
		const chosen = document.documentElement.dataset.theme
		if (chosen === 'light' || chosen === 'dark') return chosen
		return media.matches ? 'dark' : 'light'
	}
	const label = (): void => {
		const toDark = current() !== 'dark'
		for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
			const text = toDark ? button.dataset.toDark : button.dataset.toLight
			if (text !== undefined) button.setAttribute('aria-label', text)
		}
	}
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
		button.addEventListener('click', () => {
			const next = current() === 'dark' ? 'light' : 'dark'
			document.documentElement.dataset.theme = next
			try {
				localStorage.setItem('theme', next)
			} catch {}
			label()
		})
	}
	media.addEventListener('change', label)
	label()

	const menus = document.querySelectorAll<HTMLDetailsElement>('details[data-menu]')
	document.addEventListener('click', (event) => {
		for (const menu of menus) {
			if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false
		}
	})
	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return
		for (const menu of menus) {
			if (!menu.open) continue
			menu.open = false
			menu.querySelector('summary')?.focus()
		}
	})
</script>
