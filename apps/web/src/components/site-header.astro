---
import Wordmark from '@/components/wordmark.astro'

interface Props {
	active?: 'spec' | 'publish' | undefined
}

const { active } = Astro.props

const links = [
	{ key: 'spec', href: '/spec', label: 'Specification' },
	{ key: 'publish', href: '/publish', label: 'Publish' },
] as const
---

<header class="sticky top-0 z-40 border-b border-line bg-bg">
	<div class="shell flex h-14 items-center justify-between gap-6">
		<a href="/" class="rounded-sm text-[0.95rem] hover:text-accent" aria-label="prodid, home">
			<Wordmark />
		</a>
		<nav aria-label="Primary">
			<ul class="flex items-center gap-6 text-sm">
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								aria-current={active === link.key ? 'page' : undefined}
								class:list={[
									'rounded-sm underline-offset-4 hover:text-accent hover:underline',
									active === link.key ? 'font-medium text-accent' : 'text-soft',
								]}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
