{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodid.org/schemas/v0/org.prodid.feed.json",
  "title": "org.prodid.feed",
  "description": "Discovery document served at https://<domain>/.well-known/prodid.json. The domain serving it is the source identity.",
  "type": "object",
  "required": ["$type", "version", "publisher", "license", "feeds"],
  "additionalProperties": false,
  "properties": {
    "$type": { "const": "org.prodid.feed" },
    "version": { "const": 0 },
    "publisher": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "contact": { "type": "string", "format": "email" }
      }
    },
    "license": {
      "description": "SPDX license identifier covering the facts in the feeds.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "feeds": {
      "description": "NDJSON files, one org.prodid.item record per line. Must be on the same domain as the discovery document.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    }
  }
}
